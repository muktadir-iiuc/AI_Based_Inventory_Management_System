@{
    ViewData["Title"] = "বাংলাদেশ টায়ার | বাংলাদেশের জন্য নির্ভরযোগ্য টায়ার";
    ViewData["Description"] = "বাংলাদেশের রাস্তায় পারফরম্যান্স, নিরাপত্তা ও স্থায়িত্বের জন্য প্রকৌশলে তৈরি নির্ভরযোগ্য টায়ার সমাধান আবিষ্কার করুন।";
}

<a class="skip-link" href="#main-content" data-i18n="a11y.skip">মূল কন্টেন্টে যান</a>

<!-- ============ HERO ============ -->
<section class="hero" id="top">
    <div class="hero-bg" aria-hidden="true">
        <div class="hero-grid"></div>
        <div class="hero-glow"></div>
        <svg class="hero-tyre" width="640" height="640" viewBox="0 0 640 640" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="320" cy="320" r="300" stroke="url(#tyreGrad)" stroke-width="26"/>
            <circle cx="320" cy="320" r="230" stroke="#1E3A5F" stroke-width="3" stroke-dasharray="4 10"/>
            <circle cx="320" cy="320" r="150" stroke="#1E3A5F" stroke-width="10"/>
            <circle cx="320" cy="320" r="40" fill="#0B1B2B" stroke="#38BDF8" stroke-width="2"/>
            <defs>
                <linearGradient id="tyreGrad" x1="0" y1="0" x2="640" y2="640" gradientUnits="userSpaceOnUse">
                    <stop stop-color="#102A43"/>
                    <stop offset="1" stop-color="#0B1B2B"/>
                </linearGradient>
            </defs>
        </svg>
    </div>

    <div class="container hero-content">
        <p class="eyebrow reveal" data-i18n="hero.eyebrow">রাস্তার জন্য প্রকৌশলে তৈরি</p>
        <h1 class="hero-title reveal" data-i18n-html="hero.title">প্রতিটি যাত্রায়<br>আস্থার নিশ্চয়তা</h1>
        <p class="hero-sub reveal" data-i18n="hero.sub">
            বাংলাদেশের রাস্তায় পারফরম্যান্স, নিরাপত্তা ও স্থায়িত্বের জন্য প্রকৌশলে তৈরি
            নির্ভরযোগ্য টায়ার সমাধান।
        </p>
        <div class="hero-actions reveal">
            <a href="#products" class="btn btn-accent btn-lg" data-i18n="hero.cta1">আমাদের টায়ার দেখুন</a>
            <a href="#about" class="btn btn-outline-light btn-lg" data-i18n="hero.cta2">বাংলাদেশ টায়ার সম্পর্কে জানুন</a>
        </div>
    </div>

    <a href="#stats" class="scroll-indicator" aria-label="Scroll to next section">
        <span></span>
    </a>
</section>

<!-- ============ TRUST / STATS ============ -->
<section class="stats-section" id="stats">
    <div class="container">
        <div class="stats-grid">
            <div class="stat-item reveal">
                <span class="stat-number" data-counter data-target="25" data-suffix="+">0</span>
                <span class="stat-label" data-i18n="stats.years">বছরের অভিজ্ঞতা</span>
            </div>
            <div class="stat-item reveal">
                <span class="stat-number" data-counter data-target="500" data-suffix="+">0</span>
                <span class="stat-label" data-i18n="stats.dealers">ডিলার নেটওয়ার্ক</span>
            </div>
            <div class="stat-item reveal">
                <span class="stat-number" data-counter data-target="1" data-suffix="M+">0</span>
                <span class="stat-label" data-i18n="stats.tyres">রাস্তায় চলমান টায়ার</span>
            </div>
            <div class="stat-item reveal">
                <span class="stat-number stat-text" data-i18n="stats.nationwide">সারাদেশে</span>
                <span class="stat-label" data-i18n="stats.coverage">সেবা কভারেজ</span>
            </div>
        </div>
        <p class="stats-disclaimer" data-i18n="stats.disclaimer">প্রদর্শিত পরিসংখ্যান প্রাথমিক বিপণন তথ্য, যাচাইকৃত কোম্পানির তথ্যের অপেক্ষায়।</p>
    </div>
</section>

<!-- ============ ABOUT ============ -->
<section class="about-section" id="about">
    <div class="container about-grid">
        <div class="about-visual reveal">
            <div class="about-badge" data-i18n="about.badge">বিশ্বস্ত টায়ার সমাধান</div>
            <div class="about-panel">
                <svg viewBox="0 0 400 400" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Illustration of a tyre cross-section representing Bangladesh Tyre engineering">
                    <rect width="400" height="400" rx="24" fill="#0B1B2B"/>
                    <circle cx="200" cy="200" r="150" fill="none" stroke="#102A43" stroke-width="36"/>
                    <circle cx="200" cy="200" r="150" fill="none" stroke="#38BDF8" stroke-width="4" stroke-dasharray="2 14"/>
                    <circle cx="200" cy="200" r="96" fill="none" stroke="#1E3A5F" stroke-width="14"/>
                    <circle cx="200" cy="200" r="40" fill="#07111F" stroke="#38BDF8" stroke-width="2"/>
                    <circle cx="200" cy="200" r="6" fill="#38BDF8"/>
                </svg>
                <div class="about-panel-card">
                    <span class="about-panel-number">২৫+</span>
                    <span class="about-panel-text" data-i18n="about.panel">বাংলাদেশের রাস্তায় সেবাদানের বছর</span>
                </div>
            </div>
        </div>
        <div class="about-copy reveal">
            <p class="eyebrow" data-i18n="about.eyebrow">বাংলাদেশ টায়ার সম্পর্কে</p>
            <h2 class="section-title" data-i18n-html="about.title">বাংলাদেশের জন্য তৈরি।<br>পারফরম্যান্স দ্বারা পরিচালিত।</h2>
            <p class="section-lead" data-i18n="about.lead">
                বাংলাদেশ টায়ার দেশের রাস্তা, যানবাহন ও গ্রাহকদের চাহিদা অনুযায়ী নির্ভরযোগ্য
                টায়ার সমাধান প্রদানে প্রতিশ্রুতিবদ্ধ — ব্যস্ত শহরের রাস্তা থেকে দীর্ঘ মহাসড়ক
                যাত্রা পর্যন্ত।
            </p>
            <ul class="about-points">
                <li><i class="bi bi-patch-check-fill" aria-hidden="true"></i><span data-i18n-html="about.point1"><strong>প্রমাণিত অভিজ্ঞতা</strong> — স্থানীয় রাস্তার পরিস্থিতি অনুযায়ী দশকের টায়ার দক্ষতা।</span></li>
                <li><i class="bi bi-shield-check" aria-hidden="true"></i><span data-i18n-html="about.point2"><strong>গুণমানের প্রতিশ্রুতি</strong> — প্রতিটি টায়ার নিরাপত্তা ও সামঞ্জস্যতার ভিত্তিতে তৈরি।</span></li>
                <li><i class="bi bi-people-fill" aria-hidden="true"></i><span data-i18n-html="about.point3"><strong>গ্রাহক কেন্দ্রিকতা</strong> — প্রকৃত গ্রাহক চাহিদার ভিত্তিতে সারাদেশে সহায়তা।</span></li>
                <li><i class="bi bi-speedometer2" aria-hidden="true"></i><span data-i18n-html="about.point4"><strong>পারফরম্যান্স</strong> — স্থিতিশীলতা, মাইলেজ ও স্থায়িত্বের জন্য প্রকৌশলে তৈরি।</span></li>
            </ul>
            <a href="#why-us" class="btn btn-primary-dark" data-i18n="about.cta">আমাদের সম্পর্কে আরও জানুন</a>
        </div>
    </div>
</section>

<!-- ============ PRODUCTS ============ -->
<section class="products-section" id="products">
    <div class="container">
        <div class="section-head reveal">
            <p class="eyebrow" data-i18n="products.eyebrow">আমাদের টায়ার সমাধান</p>
            <h2 class="section-title" data-i18n-html="products.title">যেখানেই যান,<br>পারফরম্যান্সের জন্য প্রকৌশলে তৈরি</h2>
        </div>

        <div class="product-filters reveal" role="tablist" aria-label="Filter tyre products by category">
            <button class="filter-btn active" type="button" data-filter="all" role="tab" aria-selected="true" data-i18n="filter.all">সকল</button>
            <button class="filter-btn" type="button" data-filter="passenger" role="tab" aria-selected="false" data-i18n="filter.passenger">যাত্রীবাহী</button>
            <button class="filter-btn" type="button" data-filter="commercial" role="tab" aria-selected="false" data-i18n="filter.commercial">কমার্শিয়াল</button>
            <button class="filter-btn" type="button" data-filter="cng" role="tab" aria-selected="false" data-i18n="filter.cng">সিএনজি অটোরিকশা</button>
            <button class="filter-btn" type="button" data-filter="motorcycle" role="tab" aria-selected="false" data-i18n="filter.motorcycle">মোটরসাইকেল</button>
        </div>

        <div class="product-grid" id="productGrid">
            <article class="product-card reveal" data-category="passenger">
                <div class="product-media">
                    <img src="~/images/products/passenger-car.jpg" alt="যাত্রীবাহী গাড়ির চাকা ও টায়ারের ক্লোজ-আপ" loading="lazy" width="800" height="533" style="object-position: 50% 65%;">
                </div>
                <div class="product-body">
                    <h3 data-i18n="product.passenger.title">যাত্রীবাহী গাড়ি</h3>
                    <p data-i18n="product.passenger.desc">প্রতিদিনের ড্রাইভিংয়ের জন্য আরাম, স্থিতিশীলতা ও নির্ভরযোগ্য রাস্তার পারফরম্যান্স।</p>
                    <button type="button" class="product-link" data-product-detail="passenger"><span data-i18n="product.viewdetails">বিস্তারিত দেখুন</span> <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                </div>
            </article>

            <article class="product-card reveal" data-category="commercial">
                <div class="product-media">
                    <img src="~/images/products/commercial-vehicle.jpg" alt="হালকা কমার্শিয়াল কাজে ব্যবহৃত আধুনিক পিকআপ" loading="lazy" width="800" height="533" style="object-position: 50% 60%;">
                </div>
                <div class="product-body">
                    <h3 data-i18n="product.commercial.title">কমার্শিয়াল যানবাহন</h3>
                    <p data-i18n="product.commercial.desc">কঠোর কাজের চাপ ও দীর্ঘ দূরত্বের যাত্রার জন্য তৈরি।</p>
                    <button type="button" class="product-link" data-product-detail="commercial"><span data-i18n="product.viewdetails">বিস্তারিত দেখুন</span> <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                </div>
            </article>

            <article class="product-card reveal" data-category="cng">
                <div class="product-media">
                    <img src="~/images/products/cng-auto-rickshaw.jpg" alt="বাংলাদেশের একটি সবুজ সিএনজি অটোরিকশা" loading="lazy" width="800" height="533" style="object-position: 50% 55%;">
                </div>
                <div class="product-body">
                    <h3 data-i18n="product.cng.title">সিএনজি অটোরিকশা</h3>
                    <p data-i18n="product.cng.desc">বাংলাদেশের শহর ও শহরতলির যাতায়াতের জন্য নির্ভরযোগ্য ও সাশ্রয়ী তিন চাকার বাহন।</p>
                    <button type="button" class="product-link" data-product-detail="cng"><span data-i18n="product.viewdetails">বিস্তারিত দেখুন</span> <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                </div>
            </article>

            <article class="product-card reveal" data-category="motorcycle">
                <div class="product-media">
                    <img src="~/images/products/motorcycle.jpg" alt="স্টুডিওতে ধারণকৃত মোটরসাইকেলের সাইড প্রোফাইল" loading="lazy" width="800" height="533" style="object-position: 50% 60%;">
                </div>
                <div class="product-body">
                    <h3 data-i18n="product.motorcycle.title">মোটরসাইকেল</h3>
                    <p data-i18n="product.motorcycle.desc">প্রতিটি রুটে দ্রুত হ্যান্ডলিং ও প্রতিদিনের নির্ভরযোগ্যতা।</p>
                    <button type="button" class="product-link" data-product-detail="motorcycle"><span data-i18n="product.viewdetails">বিস্তারিত দেখুন</span> <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                </div>
            </article>
        </div>

        <p class="stats-disclaimer" data-i18n="products.disclaimer">যানবাহনের ছবি শুধুমাত্র দৃষ্টান্তমূলক উদ্দেশ্যে ব্যবহৃত, এটি বাংলাদেশ টায়ারের কোনো নির্দিষ্ট বহর বা পণ্য ফিটমেন্ট নির্দেশ করে না।</p>
    </div>

    <!-- Product detail templates (read by JS into the shared modal; keeps content out of site.js) -->
    <div hidden>
        <div id="detail-passenger" data-image="@Url.Content("~/images/products/passenger-car.jpg")" data-title="যাত্রীবাহী গাড়ির টায়ার" data-title-en="Passenger Car Tyres" data-i18n-html="detail.passenger.body">
            <p>প্রতিদিনের শহর ভ্রমণ, পারিবারিক যাত্রা ও নিয়মিত যাতায়াতের জন্য আরাম, স্থিতিশীলতা ও দক্ষতার ভারসাম্য বজায় রেখে তৈরি টায়ার।</p>
            <ul>
                <li>বিভিন্ন রাস্তার পৃষ্ঠে সুষম রাইড কমফোর্ট</li>
                <li>দ্রুত স্টিয়ারিং ও কর্নারিং স্থিতিশীলতা</li>
                <li>জ্বালানি সাশ্রয়ের জন্য উপযোগী ট্রেড কম্পাউন্ড</li>
                <li>নির্ভরযোগ্য অল-সিজন ট্র্যাকশন</li>
            </ul>
        </div>
        <div id="detail-commercial" data-image="@Url.Content("~/images/products/commercial-vehicle.jpg")" data-title="কমার্শিয়াল যানবাহনের টায়ার" data-title-en="Commercial Vehicle Tyres" data-i18n-html="detail.commercial.body">
            <p>ভ্যান, পিকআপ ও হালকা কমার্শিয়াল যানবাহনের জন্য তৈরি, যা প্রতিদিন শহর ও তার বাইরে মালামাল পরিবহন করে।</p>
            <ul>
                <li>নিয়মিত লোডের জন্য শক্তিশালী নির্মাণ</li>
                <li>পূর্ণ পেলোডেও স্থিতিশীল হ্যান্ডলিং</li>
                <li>দীর্ঘ সার্ভিস লাইফের জন্য সুষম ক্ষয়</li>
                <li>ফ্লিট ডিউটি সাইকেলে নির্ভরযোগ্য পারফরম্যান্স</li>
            </ul>
        </div>
        <div id="detail-cng" data-image="@Url.Content("~/images/products/cng-auto-rickshaw.jpg")" data-title="সিএনজি অটোরিকশার টায়ার" data-title-en="CNG Auto-rickshaw Tyres" data-i18n-html="detail.cng.body">
            <p>বাংলাদেশের ব্যস্ত শহর ও শহরতলির রাস্তায় প্রতিদিনের যাত্রীসেবার জন্য তৈরি তিন চাকার বাহনের টায়ার।</p>
            <ul>
                <li>ঘন ঘন থামা-চলার জন্য উপযোগী নির্মাণ</li>
                <li>সংকীর্ণ বাঁক ও কম গতিতে ভালো নিয়ন্ত্রণ</li>
                <li>দৈনিক দীর্ঘ ব্যবহারের জন্য টেকসই গঠন</li>
                <li>সাশ্রয়ী মূল্যে নির্ভরযোগ্য পারফরম্যান্স</li>
            </ul>
        </div>
        <div id="detail-motorcycle" data-image="@Url.Content("~/images/products/motorcycle.jpg")" data-title="মোটরসাইকেলের টায়ার" data-title-en="Motorcycle Tyres" data-i18n-html="detail.motorcycle.body">
            <p>মোটরসাইকেল চালকদের প্রয়োজনীয় দ্রুততা, ব্রেকিং ও প্রতিদিনের নির্ভরযোগ্যতার জন্য তৈরি টায়ার।</p>
            <ul>
                <li>তীক্ষ্ণ কর্নারিং গ্রিপ ও লিন স্থিতিশীলতা</li>
                <li>হালকা ও দ্রুত সাড়াদানকারী নির্মাণ</li>
                <li>ভেজা ও শুকনো উভয় অবস্থায় আত্মবিশ্বাসী হ্যান্ডলিং</li>
                <li>প্রতিদিনের যাতায়াতের জন্য নির্ভরযোগ্য স্থায়িত্ব</li>
            </ul>
        </div>
    </div>
</section>

<!-- ============ PRODUCT DETAIL MODAL ============ -->
<div class="product-modal" id="productModal" hidden>
    <div class="product-modal-backdrop" data-modal-close></div>
    <div class="product-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="productModalTitle">
        <button type="button" class="product-modal-close" data-modal-close aria-label="Close details">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
        <div class="product-modal-media">
