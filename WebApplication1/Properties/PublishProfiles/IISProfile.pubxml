    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>app.bangladesh-tyre.com</SiteUrlToLaunchAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <ProjectGuid>1139e486-a36b-6b58-4965-3753d45010a4</ProjectGuid>
    <SelfContained>false</SelfContained>
    <MSDeployServiceURL>plesk9700.is.cc</MSDeployServiceURL>
    <DeployIisAppPath>app.bangladesh-tyre.com</DeployIisAppPath>
    <RemoteSitePhysicalPath />
