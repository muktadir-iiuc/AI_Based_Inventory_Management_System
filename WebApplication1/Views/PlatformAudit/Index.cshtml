@model AuditListViewModel
@{ ViewData["Title"] = "Audit logs"; }

@section Toolbar {
    @if (User.IsInRole(Roles.PlatformAdmin))
    {
        <a href="/Platform/AuditLogs/Export.csv?act=@Model.Action&actor=@Model.Actor&result=@Model.Result&tenantId=@Model.TenantId&from=@Model.From?.ToString("yyyy-MM-dd")&to=@Model.To?.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-sm"><i class="fas fa-download"></i> CSV</a>
    }
}

<div class="card mb-3"><div class="card-body">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-6 col-md-2"><label class="form-label small mb-0">Action contains</label><input name="act" value="@Model.Action" class="form-control form-control-sm" placeholder="payment." /></div>
        <div class="col-6 col-md-2"><label class="form-label small mb-0">Actor</label><input name="actor" value="@Model.Actor" class="form-control form-control-sm" /></div>
        <div class="col-6 col-md-2"><label class="form-label small mb-0">Result</label><select name="result" class="form-select form-select-sm"><option value="">All</option><option selected="@(Model.Result == "Success")">Success</option><option selected="@(Model.Result == "Failed")">Failed</option><option selected="@(Model.Result == "Rejected")">Rejected</option></select></div>
        <div class="col-6 col-md-1"><label class="form-label small mb-0">Tenant id</label><input name="tenantId" value="@Model.TenantId" class="form-control form-control-sm" inputmode="numeric" /></div>
        <div class="col-6 col-md-2"><label class="form-label small mb-0">From</label><input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
        <div class="col-6 col-md-2"><label class="form-label small mb-0">To</label><input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
        <div class="col-12 col-md-1 d-flex gap-2"><button class="btn btn-primary btn-sm flex-grow-1">Go</button></div>
    </form>
</div></div>

<div class="card">
    <div class="card-body p-0 table-responsive">
        <table class="table table-sm table-striped mb-0">
            <thead><tr><th>Time</th><th>Actor</th><th>Action</th><th>Entity</th><th>Tenant</th><th>Result</th><th>Details</th><th>IP</th></tr></thead>
            <tbody>
            @foreach (var a in Model.Page.Items)
            {
                <tr class="@(a.Result == "Success" ? "" : "table-warning")">
                    <td class="text-nowrap">@a.At.ToLocalTime().ToString("dd MMM yy hh:mm:ss tt")</td>
                    <td>@a.ActorName</td>
                    <td>@a.Action</td>
                    <td class="small">@a.EntityType @a.EntityId</td>
                    <td>@if (a.TenantId is int t) { <a href="/Platform/Tenants/@t">@t</a> }</td>
                    <td>@a.Result</td>
                    <td class="small">@a.Details</td>
                    <td class="small">@a.IpAddress</td>
                </tr>
            }
            @if (Model.Page.Items.Count == 0) { <tr><td colspan="8" class="text-center text-muted p-4">No entries.</td></tr> }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Page.Pager" />
</div>
