@using WebApplication1.Models.Saas
@using WebApplication1.Services.Saas
@model PagedResult<TenantSubscription>
@{
    ViewData["Title"] = "Subscriptions";
    var plans = (List<SubscriptionPlan>)ViewData["Plans"]!;
    var status = ViewData["Status"] as string;
    var planId = ViewData["PlanId"] as int?;
}

<div class="card mb-3"><div class="card-body">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-12 col-md-4"><label class="form-label small mb-0">Tenant</label><input name="q" value="@ViewData["Q"]" class="form-control form-control-sm" placeholder="Name or code" /></div>
        <div class="col-6 col-md-3"><label class="form-label small mb-0">Status</label><select name="status" class="form-select form-select-sm"><option value="">All</option>@foreach (var s in Enum.GetValues<SubscriptionStatus>()) { <option value="@s" selected="@(status == s.ToString())">@s</option> }</select></div>
        <div class="col-6 col-md-3"><label class="form-label small mb-0">Plan</label><select name="planId" class="form-select form-select-sm"><option value="">All</option>@foreach (var p in plans) { <option value="@p.Id" selected="@(planId == p.Id)">@p.Name</option> }</select></div>
        <div class="col-12 col-md-2 d-flex gap-2"><button class="btn btn-primary btn-sm flex-grow-1">Filter</button><a href="/Platform/Subscriptions" class="btn btn-outline-secondary btn-sm">Reset</a></div>
    </form>
</div></div>

<div class="card">
    <div class="card-body p-0 table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead><tr><th>Tenant</th><th>Plan</th><th>Status</th><th>Price</th><th>Started</th><th>Trial ends</th><th>Paid until</th><th>Grace ends</th><th>Renewal</th></tr></thead>
            <tbody>
            @foreach (var s in Model.Items)
            {
                <tr>
                    <td><a href="/Platform/Tenants/@s.TenantId">@s.Tenant?.Name</a></td>
                    <td>@s.Plan?.Name</td>
                    <td><partial name="_SubscriptionBadge" model="s.Status" /></td>
                    <td class="text-nowrap">@s.Price.ToString("#,0.##") @s.Currency / @BillingMath.DescribeInterval(s.IntervalCount, s.IntervalUnit)</td>
                    <td>@s.StartedAt.ToLocalTime().ToString("dd MMM yy")</td>
                    <td>@s.TrialEndsAt?.ToLocalTime().ToString("dd MMM yy")</td>
                    <td>@s.CurrentPeriodEnd?.ToLocalTime().ToString("dd MMM yy")</td>
                    <td>@s.GraceEndsAt?.ToLocalTime().ToString("dd MMM yy")</td>
                    <td>@(s.CancelAtPeriodEnd ? "ending" : s.AutoRenew ? "auto" : "manual")</td>
                </tr>
            }
            @if (Model.Items.Count == 0) { <tr><td colspan="9" class="text-center text-muted p-4">No subscriptions match.</td></tr> }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Pager" />
</div>
