@model List<Product>
@{
    ViewData["Title"] = "Products";
    var categoryList = (SelectList)ViewData["CategoryId"]!;
}

@section Toolbar {
    @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager) || User.IsInRole(Roles.PurchaseOfficer))
    {
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> New Product</a>
    }
}

<div class="card">
    <div class="card-header">
        <form method="get" class="row g-2">
            <div class="col-auto">
                <input type="text" name="search" value="@ViewData["Search"]" class="form-control form-control-sm" placeholder="Search by name or SKU..." />
            </div>
            <div class="col-auto">
                <select name="categoryId" asp-items="categoryList" class="form-select form-select-sm">
                    <option value="">All categories</option>
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-outline-secondary" type="submit"><i class="fas fa-search"></i> Filter</button>
            </div>
        </form>
    </div>
    <div class="card-body p-0 table-responsive-card">
        <table class="table table-striped table-hover mb-0 data-table" id="productTable">
            <thead>
                <tr>
                    <th>SKU</th><th>Name</th><th data-filter="select">Category</th><th>Unit</th>
                    <th class="text-end" title="Default suggestion for the next purchase — actual cost/price live per batch">Last Cost</th>
                    <th class="text-end" title="Default suggestion for the next purchase — actual cost/price live per batch">Default Price</th>
                    <th class="text-end">Stock</th><th data-filter="false"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr class="clickable-row @(p.CurrentStock <= p.ReorderLevel ? "table-warning" : "")" data-href="@Url.Action("Details", new { id = p.Id })">
                    <td>@p.Sku</td>
                    <td><a asp-action="Details" asp-route-id="@p.Id" class="fw-semibold">@p.Name</a></td>
                    <td>@p.Category?.Name</td>
                    <td>@p.UnitOfMeasure?.Symbol</td>
                    <td class="text-end">@p.CostPrice.ToString("C")</td>
                    <td class="text-end">@p.SalePrice.ToString("C")</td>
                    <td class="text-end">
                        @p.CurrentStock.ToString("0.##")
                        @if (p.CurrentStock <= p.ReorderLevel)
                        {
                            <i class="fas fa-triangle-exclamation text-warning ms-1" title="At or below reorder level"></i>
                        }
                    </td>
                    <td class="text-end">
                        @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager) || User.IsInRole(Roles.PurchaseOfficer))
                        {
                            <div class="table-actions">
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary" title="Edit product"><i class="fas fa-pen"></i></a>
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="confirm-delete" data-confirm-message="Delete this product?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete product"><i class="fas fa-trash"></i></button>
                                </form>
                            </div>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<style>
    #productTable tbody tr.clickable-row { cursor: pointer; }
    #productTable tbody tr.clickable-row:hover { background-color: var(--bs-tertiary-bg); }
</style>

@section Scripts {
    <script>
        document.getElementById('productTable').addEventListener('click', function (e) {
            if (e.target.closest('a, button, input, form')) return;
            var row = e.target.closest('tr.clickable-row');
            if (row && row.dataset.href) {
                window.location.href = row.dataset.href;
            }
        });
    </script>
}
