@model Product
@{
    ViewData["Title"] = $"Product: {Model.Name}";
    var scopedStock = ViewData["ScopedStock"] as decimal?;
    var warehouseNames = (Dictionary<int, string>)ViewData["WarehouseNames"]!;
    var warehouseNamesJson = System.Text.Json.JsonSerializer.Serialize(warehouseNames.ToDictionary(kv => kv.Key.ToString(), kv => kv.Value));
    var currencySymbol = System.Globalization.CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol;
}
<span id="pdMeta" class="d-none" data-product-id="@Model.Id" data-warehouse-names='@Html.Raw(warehouseNamesJson)' data-currency-symbol="@currencySymbol"></span>

<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header"><h3 class="card-title">Details</h3></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">SKU</dt><dd class="col-7">@Model.Sku</dd>
                    <dt class="col-5">Name</dt><dd class="col-7">@Model.Name</dd>
                    <dt class="col-5">Brand</dt><dd class="col-7">@(string.IsNullOrWhiteSpace(Model.Brand) ? "—" : Model.Brand)</dd>
                    <dt class="col-5">Size</dt><dd class="col-7">@(string.IsNullOrWhiteSpace(Model.Size) ? "—" : Model.Size)</dd>
                    <dt class="col-5">Category</dt><dd class="col-7">@Model.Category?.Name</dd>
                    <dt class="col-5">Unit</dt><dd class="col-7">@Model.UnitOfMeasure?.Name (@Model.UnitOfMeasure?.Symbol)</dd>
                    <dt class="col-5">Last Cost <small class="text-muted">(default)</small></dt><dd class="col-7">@Model.CostPrice.ToString("C")</dd>
                    <dt class="col-5">Default Sale Price</dt><dd class="col-7"><span id="salePriceValue">@Model.SalePrice.ToString("C")</span></dd>
                    <dt class="col-5">Current Stock</dt>
                    <dd class="col-7">
                        @if (scopedStock is { } stock)
                        {
                            <span id="currentStockValue">@stock.ToString("0.##")</span> <small class="text-muted">(your assigned warehouse(s))</small>
                        }
                        else
                        {
                            <span id="currentStockValue">@Model.CurrentStock.ToString("0.##")</span> <small class="text-muted">(all warehouses)</small>
                        }
                    </dd>
                    <dt class="col-5">Reorder Level</dt><dd class="col-7">@Model.ReorderLevel.ToString("0.##")</dd>
                    <dt class="col-5">Status</dt>
                    <dd class="col-7">
                        @if (Model.IsActive) { <span class="badge text-bg-success">Active</span> }
                        else { <span class="badge text-bg-secondary">Inactive</span> }
                    </dd>
                </dl>
            </div>
            <div class="card-footer">
                <a asp-action="Index" class="btn btn-secondary btn-sm">Back to list</a>
                <a asp-action="PriceHistory" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm"><i class="fas fa-clock-rotate-left"></i> Price History</a>
                @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager) || User.IsInRole(Roles.PurchaseOfficer))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Edit</a>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h3 class="card-title">Stock by Warehouse</h3></div>
            <div class="card-body p-0 table-responsive-card">
                <table class="table table-striped mb-0">
                    <thead><tr><th>Warehouse</th><th class="text-end">Qty</th></tr></thead>
                    <tbody id="warehouseStockBody">
                    @foreach (var s in Model.WarehouseStocks.OrderBy(s => s.Warehouse!.Name))
                    {
                        <tr data-warehouse-id="@s.WarehouseId">
                            <td>@s.Warehouse?.Name</td>
                            <td class="text-end qty-value">@s.Quantity.ToString("0.##")</td>
                        </tr>
                    }
                    @if (!Model.WarehouseStocks.Any())
                    {
                        <tr data-empty><td colspan="2" class="text-center text-muted py-3">No stock in any warehouse.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card">
            <div class="card-header"><h3 class="card-title">Recent Stock Movements</h3></div>
            <div class="card-body p-0 table-responsive-card">
                <table class="table table-striped mb-0">
                    <thead><tr><th>Date</th><th>Warehouse</th><th>Type</th><th class="text-end">Qty</th><th>Reference</th></tr></thead>
                    <tbody>
                    @foreach (var t in Model.StockTransactions)
                    {
                        <tr>
                            <td>@t.Date.ToString("MMM dd, yyyy")</td>
                            <td>@t.Warehouse?.Name</td>
                            <td>
                                @if (t.Type == StockTransactionType.In) { <span class="badge text-bg-success">In</span> }
                                else { <span class="badge text-bg-danger">Out</span> }
                            </td>
                            <td class="text-end">@t.Quantity.ToString("0.##")</td>
                            <td>@t.Reference</td>
                        </tr>
                    }
                    @if (!Model.StockTransactions.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-3">No stock movements yet.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var meta = document.getElementById('pdMeta');
            var productId = parseInt(meta.dataset.productId, 10);
            var warehouseNames = JSON.parse(meta.dataset.warehouseNames || '{}');
            var tbody = document.getElementById('warehouseStockBody');
            var priceEl = document.getElementById('salePriceValue');
            var stockEl = document.getElementById('currentStockValue');

            function formatQty(n) {
                n = Number(n) || 0;
                return n.toFixed(2).replace(/\.?0+$/, '');
            }

            function formatMoney(n) {
                var symbol = meta.dataset.currencySymbol || '';
                return symbol + (Number(n) || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function flash(el) {
                if (!el) return;
                el.classList.add('text-bg-warning');
                setTimeout(function () { el.classList.remove('text-bg-warning'); }, 1200);
            }

            function recomputeTotal() {
                if (!stockEl) return;
                var total = 0;
                tbody.querySelectorAll('tr[data-warehouse-id]').forEach(function (row) {
                    total += Number(row.querySelector('.qty-value').textContent) || 0;
                });
                stockEl.textContent = formatQty(total);
                flash(stockEl);
            }

            // Live price/stock updates pushed over SignalR (see _Layout.cshtml).
            window.addEventListener('app:data-update', function (e) {
                var d = e.detail;
                if (d.type === 'ProductPrice' && d.data.productId === productId) {
                    if (priceEl) { priceEl.textContent = formatMoney(d.data.salePrice); flash(priceEl); }
                    return;
                }

                if (d.type === 'StockChange') {
                    var entry = (d.data.products || []).find(function (p) { return p.productId === productId; });
                    if (!entry) return;

                    var changed = false;
                    Object.keys(entry.warehouseStocks || {}).forEach(function (wid) {
                        var qty = Number(entry.warehouseStocks[wid]) || 0;
                        var row = tbody.querySelector('tr[data-warehouse-id="' + wid + '"]');
                        if (!row) {
                            if (qty === 0) return; // don't bother inserting a zero row
                            var placeholder = tbody.querySelector('tr[data-empty]');
                            if (placeholder) placeholder.remove();
                            row = document.createElement('tr');
                            row.setAttribute('data-warehouse-id', wid);
                            row.innerHTML = '<td></td><td class="text-end qty-value"></td>';
                            row.querySelector('td').textContent = warehouseNames[wid] || ('Warehouse ' + wid);
                            tbody.appendChild(row);
                        }
                        row.querySelector('.qty-value').textContent = formatQty(qty);
                        flash(row.querySelector('.qty-value'));
                        changed = true;
                    });
                    if (changed) recomputeTotal();
                }
            });
        })();
    </script>
}
