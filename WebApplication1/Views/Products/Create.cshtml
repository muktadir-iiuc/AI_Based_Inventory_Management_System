@model Product
@{
    ViewData["Title"] = "New Product";
    var categoryList = (SelectList)ViewData["Categories"]!;
    var unitList = (SelectList)ViewData["Units"]!;
}

<div class="card col-md-8">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="alert alert-info py-2 small mb-3"><i class="fas fa-circle-info"></i> The SKU code is generated automatically from the selected category once you save.</div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label required-asterisk"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="CategoryId" class="form-label required-asterisk"></label>
                    <select asp-for="CategoryId" asp-items="categoryList" class="form-select">
                        <option value="">-- select category --</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="UnitOfMeasureId" class="form-label required-asterisk"></label>
                    <select asp-for="UnitOfMeasureId" asp-items="unitList" class="form-select">
                        <option value="">-- select unit --</option>
                    </select>
                </div>
            </div>
            <div class="alert alert-info py-2 small mb-3"><i class="fas fa-circle-info"></i> Cost and sale price are set per batch on each purchase, not on the product itself — record the first purchase to price this product.</div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="ReorderLevel" class="form-label required-asterisk"></label>
                    <input asp-for="ReorderLevel" class="form-control" type="number" step="0.01" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
