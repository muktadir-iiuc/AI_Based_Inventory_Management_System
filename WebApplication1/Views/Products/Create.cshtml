@model Product
@{
    ViewData["Title"] = "New Product";
    var categoryList = (SelectList)ViewData["Categories"]!;
    var unitList = (SelectList)ViewData["Units"]!;
}

<form asp-action="Create" method="post" id="productForm">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title">Product Details</h3>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label required-asterisk"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Wireless Mouse" autofocus />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional — shown on the product details page"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Brand" class="form-label"></label>
                            <input asp-for="Brand" class="form-control" placeholder="Optional — e.g. Bridgestone" />
                            <span asp-validation-for="Brand" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Size" class="form-label"></label>
                            <input asp-for="Size" class="form-control" placeholder="Optional — e.g. 195/65 R15" />
                            <span asp-validation-for="Size" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CategoryId" class="form-label required-asterisk"></label>
                            <select asp-for="CategoryId" asp-items="categoryList" class="form-select" id="categorySelect">
                                <option value="">-- select category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="UnitOfMeasureId" class="form-label required-asterisk"></label>
                            <select asp-for="UnitOfMeasureId" asp-items="unitList" class="form-select">
                                <option value="">-- select unit --</option>
                            </select>
                            <span asp-validation-for="UnitOfMeasureId" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Inventory Settings</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <label asp-for="ReorderLevel" class="form-label required-asterisk"></label>
                            <input asp-for="ReorderLevel" class="form-control" type="number" step="0.01" min="0" />
                            <span asp-validation-for="ReorderLevel" class="text-danger small"></span>
                            <div class="form-text">You'll be alerted on the dashboard once stock falls to or below this level.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card position-sticky" style="top: 1rem;">
                <div class="card-header">
                    <h3 class="card-title">Before You Save</h3>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="text-muted small mb-1">SKU (auto-generated)</div>
                        <div class="fs-5 fw-semibold text-muted" id="skuPreview">Select a category to preview</div>
                        <div class="form-text">Built from the category name plus a running number — the exact code is assigned when you save.</div>
                    </div>
                    <hr />
                    <div class="small text-muted">
                        Cost and sale price aren't set here — they're recorded per batch on each purchase. Record the first purchase invoice for this product to price it and bring it into stock.
                    </div>
                </div>
                <div class="card-footer d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Save Product</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            const categorySelect = document.getElementById('categorySelect');
            const skuPreview = document.getElementById('skuPreview');

            function buildPrefix(name) {
                const letters = (name || '').replace(/[^a-zA-Z]/g, '').toUpperCase();
                return letters.length >= 3 ? letters.slice(0, 3) : letters.padEnd(3, 'X');
            }

            function updateSkuPreview() {
                const option = categorySelect.selectedOptions[0];
                if (!categorySelect.value || !option) {
                    skuPreview.textContent = 'Select a category to preview';
                    skuPreview.classList.add('text-muted');
                    return;
                }
                skuPreview.classList.remove('text-muted');
                skuPreview.textContent = `${buildPrefix(option.text)}-###`;
            }

            categorySelect.addEventListener('change', updateSkuPreview);
            // Select2 (auto-applied to every .form-select) doesn't reliably re-fire the native
            // 'change' event across browsers — bind its own events too. See feedback memory on
            // this recurring gotcha for any Select2 + auto-fill page in this app.
            if (typeof jQuery !== 'undefined') {
                jQuery(categorySelect).on('select2:select select2:clear', updateSkuPreview);
            }
        })();
    </script>
    <partial name="_ValidationScriptsPartial" />
}
