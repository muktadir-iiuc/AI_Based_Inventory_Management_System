@model List<Product>
@{
    ViewData["Title"] = "Pending Monthly Price Updates";
    var monthLabel = ViewData["MonthLabel"];
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title mb-0">Products not yet reviewed for @monthLabel</h3>
    </div>
    <div class="card-body p-0 table-responsive-card">
        <table class="table table-striped table-hover mb-0 data-table" id="pendingPriceTable">
            <thead>
                <tr>
                    <th>SKU</th><th>Product</th><th data-filter="select">Category</th>
                    <th class="text-end">Current Sale Price</th><th data-filter="false"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Sku</td>
                    <td><a asp-action="Details" asp-route-id="@p.Id">@p.Name</a></td>
                    <td>@p.Category?.Name</td>
                    <td class="text-end">@p.SalePrice.ToString("C")</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Update Price</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-muted py-4">All products have been reviewed for @monthLabel.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
