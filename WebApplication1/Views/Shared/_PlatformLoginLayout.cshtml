@inject WebApplication1.Services.Saas.IPlatformBranding Branding
@{ var platformName = ViewData["BrandName"] as string; if (string.IsNullOrWhiteSpace(platformName)) { platformName = await Branding.GetNameAsync(); } var iconUrl = ViewData["BrandLogoUrl"] as string ?? "/Platform/Logo"; }
<!DOCTYPE html>
<html lang="@WebApplication1.Services.UiLanguage.Current(Context)" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] - @platformName</title>
    <link rel="icon" href="@iconUrl" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome-free/css/all.min.css" />
    <style>
        /* Deliberately unlike the tenant sign-in: dark indigo console look, no business branding. */
        body.platform-login { min-height: 100vh; margin: 0; display: flex; align-items: center; justify-content: center; padding: 1rem;
            background: radial-gradient(1200px 600px at 10% -10%, #4338ca33, transparent), linear-gradient(160deg, #0f0e24 0%, #1b1a3f 55%, #0b1a30 100%); color: #e5e7eb; }
        .platform-card { width: 100%; max-width: 420px; background: #14132b; border: 1px solid #3730a3; border-top: 4px solid #f59e0b; border-radius: .75rem; box-shadow: 0 20px 50px #0008; }
        .platform-badge { display: inline-block; font-size: .7rem; letter-spacing: .12em; font-weight: 600; text-transform: uppercase; color: #fbbf24; border: 1px solid #f59e0b66; border-radius: 999px; padding: .15rem .65rem; }
        .platform-card .form-control { background: #0d0c20; border-color: #3730a3; color: #e5e7eb; }
        .platform-card .form-control:focus { border-color: #f59e0b; box-shadow: 0 0 0 .2rem #f59e0b33; }
        .btn-platform { background: #f59e0b; border-color: #f59e0b; color: #1f1300; font-weight: 600; }
        .btn-platform:hover { background: #fbbf24; border-color: #fbbf24; color: #1f1300; }
    </style>
</head>
<body class="platform-login">
    <div style="position:fixed;top:.5rem;right:.75rem;z-index:5"><partial name="_LanguageSwitcher" view-data='new ViewDataDictionary(ViewData) { { "SwitcherStyle", "plain" } }' /></div>
    @RenderBody()
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (WebApplication1.Services.UiLanguage.IsBangla(Context))
    {
        <script src="~/i18n/bn.js" asp-append-version="true"></script>
        <script src="~/js/i18n.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
