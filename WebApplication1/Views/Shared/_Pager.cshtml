@using Microsoft.AspNetCore.WebUtilities
@model PageInfo
@functions {
    string PageUrl(int page)
    {
        var query = Context.Request.Query
            .Where(q => !string.Equals(q.Key, "page", StringComparison.OrdinalIgnoreCase))
            .ToDictionary(q => q.Key, q => (string?)q.Value.ToString());
        query["page"] = page.ToString();
        return QueryHelpers.AddQueryString(Context.Request.Path, query);
    }
}
@if (Model.TotalPages > 1)
{
    var start = Math.Max(1, Model.PageNumber - 2);
    var end = Math.Min(Model.TotalPages, start + 4);
    start = Math.Max(1, end - 4);

    <nav aria-label="Page navigation" class="d-flex justify-content-between align-items-center flex-wrap gap-2 px-3 py-2 border-top">
        <small class="text-muted">Page @Model.PageNumber of @Model.TotalPages (@Model.TotalCount total)</small>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                <a class="page-link" href="@PageUrl(Model.PageNumber - 1)" aria-label="Previous">&laquo;</a>
            </li>
            @for (var i = start; i <= end; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="@PageUrl(i)">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link" href="@PageUrl(Model.PageNumber + 1)" aria-label="Next">&raquo;</a>
            </li>
        </ul>
    </nav>
}
