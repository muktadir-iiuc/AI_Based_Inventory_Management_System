@model List<StockTransfer>
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Stock Transfers";
    var canTransfer = (await AuthorizationService.AuthorizeAsync(User, Permissions.StockTransfer)).Succeeded;
    var postedCount = Model.Count(t => t.Status == DocumentStatus.Posted);
    var totalLines = Model.Sum(t => t.Items.Count);
}

@section Toolbar {
    @if (canTransfer)
    {
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> New Transfer</a>
    }
}

<div class="row g-3 mb-3">
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body py-3">
                <div class="text-muted small">Transfers Listed</div>
                <div class="fs-4 fw-bold">@Model.Count</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body py-3">
                <div class="text-muted small">Posted</div>
                <div class="fs-4 fw-bold text-success">@postedCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body py-3">
                <div class="text-muted small">Total Lines Moved</div>
                <div class="fs-4 fw-bold">@totalLines</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0 table-responsive-card">
        <table class="table table-striped table-hover mb-0 data-table" id="transferTable">
            <thead><tr><th>Transfer #</th><th data-filter="select">From</th><th data-filter="select">To</th><th data-filter="date">Date</th><th data-filter="select">Status</th><th class="text-end">Lines</th></tr></thead>
            <tbody>
            @foreach (var t in Model)
            {
                <tr class="clickable-row" data-href="@Url.Action("Details", new { id = t.Id })">
                    <td><a asp-action="Details" asp-route-id="@t.Id" class="fw-semibold">@t.TransferNumber</a></td>
                    <td>@t.FromWarehouse?.Name</td>
                    <td>@t.ToWarehouse?.Name</td>
                    <td data-date="@t.Date.ToString("yyyy-MM-dd")">@t.Date.ToString("MMM dd, yyyy")</td>
                    <td>
                        @if (t.Status == DocumentStatus.Posted)
                        {
                            <span class="badge text-bg-success"><i class="fas fa-check-circle"></i> Posted</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary"><i class="fas fa-ban"></i> Cancelled</span>
                        }
                    </td>
                    <td class="text-end">@t.Items.Count</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<style>
    #transferTable tbody tr.clickable-row { cursor: pointer; }
    #transferTable tbody tr.clickable-row:hover { background-color: var(--bs-tertiary-bg); }
</style>

@section Scripts {
    <script>
        document.getElementById('transferTable').addEventListener('click', function (e) {
            if (e.target.closest('a, button, input')) return;
            var row = e.target.closest('tr.clickable-row');
            if (row && row.dataset.href) {
                window.location.href = row.dataset.href;
            }
        });
    </script>
}
