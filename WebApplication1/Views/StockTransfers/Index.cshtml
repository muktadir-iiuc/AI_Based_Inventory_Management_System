@model List<StockTransfer>
@{
    ViewData["Title"] = "Stock Transfers";
    var canTransfer = ViewData["CanRequest"] is true;
    var isApprover = ViewData["IsApprover"] is true;
    var status = ViewData["Status"] as StockTransferApprovalStatus?;
    var pendingCount = (int)ViewData["PendingCount"]!;
    var postedCount = Model.Count(t => t.DisplayStatus == "Posted");
    var totalLines = Model.Sum(t => t.Items.Count);
}

@section Toolbar {
    @if (canTransfer)
    {
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> New Transfer</a>
    }
}

@if (isApprover && pendingCount > 0 && status != StockTransferApprovalStatus.Pending)
{
    <div class="alert alert-warning py-2 d-flex align-items-center justify-content-between">
        <span><i class="fas fa-hourglass-half me-1"></i> <strong>@pendingCount</strong> transfer request(s) waiting for your approval.</span>
        <a asp-action="Index" asp-route-status="@StockTransferApprovalStatus.Pending" class="btn btn-sm btn-warning">Review pending</a>
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body py-3">
                <div class="text-muted small">Transfers Listed</div>
                <div class="fs-4 fw-bold">@Model.Count</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body py-3">
                <div class="text-muted small">Posted</div>
                <div class="fs-4 fw-bold text-success">@postedCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body py-3">
                <div class="text-muted small">Total Lines Moved</div>
                <div class="fs-4 fw-bold">@totalLines</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <ul class="nav nav-pills">
            <li class="nav-item"><a class="nav-link py-1 @(status is null ? "active" : "")" asp-action="Index">All</a></li>
            @foreach (var s in Enum.GetValues<StockTransferApprovalStatus>())
            {
                <li class="nav-item">
                    <a class="nav-link py-1 @(status == s ? "active" : "")" asp-action="Index" asp-route-status="@s">
                        @s
                        @if (s == StockTransferApprovalStatus.Pending && pendingCount > 0)
                        {
                            <span class="badge text-bg-warning ms-1">@pendingCount</span>
                        }
                    </a>
                </li>
            }
        </ul>
    </div>
    <div class="card-body p-0 table-responsive-card">
        <table class="table table-striped table-hover mb-0 data-table" id="transferTable">
            <thead><tr><th>Transfer #</th><th data-filter="select">From</th><th data-filter="select">To</th><th data-filter="date">Date</th><th data-filter="select">Status</th><th class="text-end">Lines</th></tr></thead>
            <tbody>
            @foreach (var t in Model)
            {
                <tr class="clickable-row" data-href="@Url.Action("Details", new { id = t.Id })" data-transfer-id="@t.Id">
                    <td><a asp-action="Details" asp-route-id="@t.Id" class="fw-semibold">@t.TransferNumber</a></td>
                    <td>@t.FromWarehouse?.Name</td>
                    <td>@t.ToWarehouse?.Name</td>
                    <td data-date="@t.Date.ToString("yyyy-MM-dd")">@t.Date.ToString("MMM dd, yyyy")</td>
                    <td class="status-cell">
                        @switch (t.DisplayStatus)
                        {
                            case "Pending": <span class="badge text-bg-warning"><i class="fas fa-hourglass-half"></i> Pending</span> break;
                            case "Posted": <span class="badge text-bg-success"><i class="fas fa-check-circle"></i> Posted</span> break;
                            case "Rejected": <span class="badge text-bg-danger"><i class="fas fa-circle-xmark"></i> Rejected</span> break;
                            case "Withdrawn": <span class="badge text-bg-secondary"><i class="fas fa-rotate-left"></i> Withdrawn</span> break;
                            default: <span class="badge text-bg-secondary"><i class="fas fa-ban"></i> Cancelled</span> break;
                        }
                    </td>
                    <td class="text-end lines-cell">@t.Items.Count</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<style>
    #transferTable tbody tr.clickable-row { cursor: pointer; }
    #transferTable tbody tr.clickable-row:hover { background-color: var(--bs-tertiary-bg); }
</style>

@section Scripts {
    <script>
        (function () {
            var tableEl = document.getElementById('transferTable');

            tableEl.addEventListener('click', function (e) {
                if (e.target.closest('a, button, input')) return;
                var row = e.target.closest('tr.clickable-row');
                if (row && row.dataset.href) {
                    window.location.href = row.dataset.href;
                }
            });

            function statusBadge(status) {
                switch (status) {
                    case 'Pending': return '<span class="badge text-bg-warning"><i class="fas fa-hourglass-half"></i> Pending</span>';
                    case 'Posted': return '<span class="badge text-bg-success"><i class="fas fa-check-circle"></i> Posted</span>';
                    case 'Rejected': return '<span class="badge text-bg-danger"><i class="fas fa-circle-xmark"></i> Rejected</span>';
                    case 'Withdrawn': return '<span class="badge text-bg-secondary"><i class="fas fa-rotate-left"></i> Withdrawn</span>';
                    default: return '<span class="badge text-bg-secondary"><i class="fas fa-ban"></i> Cancelled</span>';
                }
            }

            function getDt() {
                return (typeof jQuery !== 'undefined' && jQuery.fn.DataTable && jQuery.fn.DataTable.isDataTable(tableEl))
                    ? jQuery(tableEl).DataTable()
                    : null;
            }

            function flash(node) {
                jQuery(node).addClass('table-info');
                setTimeout(function () { jQuery(node).removeClass('table-info'); }, 1500);
            }

            // Live transfer updates pushed over SignalR (see _Layout.cshtml) — new transfers are
            // inserted and existing ones patched in place via the DataTables API so sort/search
            // state stays consistent, rather than mutating raw DOM rows behind DataTables' back.
            window.addEventListener('app:data-update', function (e) {
                var d = e.detail;
                if (d.type !== 'StockTransferDoc') return;
                var data = d.data;
                var dt = getDt();
                var existing = tableEl.querySelector('tbody tr[data-transfer-id="' + data.id + '"]');

                if (existing) {
                    existing.querySelector('.status-cell').innerHTML = statusBadge(data.status);
                    existing.querySelector('.lines-cell').textContent = data.lineCount;
                    if (dt) { dt.row(existing).invalidate(); dt.draw(false); }
                    flash(existing);
                    return;
                }

                var rowHtml =
                    '<tr class="clickable-row" data-transfer-id="' + data.id + '" data-href="/StockTransfers/Details/' + data.id + '">' +
                    '<td><a href="/StockTransfers/Details/' + data.id + '" class="fw-semibold">' + data.transferNumber + '</a></td>' +
                    '<td>' + (data.fromWarehouseName || '') + '</td>' +
                    '<td>' + (data.toWarehouseName || '') + '</td>' +
                    '<td data-date="' + data.date + '">' + data.date + '</td>' +
                    '<td class="status-cell">' + statusBadge(data.status) + '</td>' +
                    '<td class="text-end lines-cell">' + data.lineCount + '</td>' +
                    '</tr>';

                if (dt) {
                    var node = dt.row.add(jQuery(rowHtml)).draw(false).node();
                    flash(node);
                } else {
                    tableEl.querySelector('tbody').prepend(jQuery(rowHtml)[0]);
                }
            });
        })();
    </script>
}
