@model StockTransferCreateViewModel
@{
    ViewData["Title"] = "New Stock Transfer";
    var warehouseList = (SelectList)ViewData["Warehouses"]!;
    var warehouseScoped = (bool)ViewData["WarehouseScoped"]!;
}

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post" id="transferForm">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="FromWarehouseId" class="form-label required-asterisk">From Warehouse</label>
                    @if (warehouseScoped)
                    {
                        <input class="form-control" value="@warehouseList.FirstOrDefault(w => w.Value == Model.FromWarehouseId.ToString())?.Text" readonly />
                        <input type="hidden" asp-for="FromWarehouseId" id="fromWarehouseId" />
                    }
                    else
                    {
                        <select asp-for="FromWarehouseId" asp-items="warehouseList" id="fromWarehouseId" class="form-select">
                            <option value="">-- select source --</option>
                        </select>
                    }
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="ToWarehouseId" class="form-label required-asterisk">To Warehouse</label>
                    <select asp-for="ToWarehouseId" asp-items="warehouseList" class="form-select">
                        <option value="">-- select destination --</option>
                    </select>
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="Date" class="form-label required-asterisk"></label>
                    <input asp-for="Date" class="form-control" type="date" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Notes" class="form-label"></label>
                    <input asp-for="Notes" class="form-control" />
                </div>
            </div>

            <table class="table table-bordered" id="itemsTable">
                <thead>
                    <tr>
                        <th style="width: 55%">Product</th>
                        <th style="width: 20%">Quantity to Transfer</th>
                        <th style="width: 20%">Available in Source</th>
                        <th style="width: 5%"></th>
                    </tr>
                </thead>
                <tbody id="itemsBody"></tbody>
            </table>

            <button type="button" class="btn btn-outline-secondary btn-sm mb-3" id="addRow"><i class="fas fa-plus"></i> Add product line</button>

            <div>
                <button type="submit" class="btn btn-primary">Post Transfer</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const products = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["Products"]));
        const fromWarehouseEl = document.getElementById('fromWarehouseId');
        let rowIndex = 0;

        function stockInFrom(product) {
            const fromId = parseInt(fromWarehouseEl.value, 10);
            const entry = (product.Stocks || []).find(s => s.WarehouseId === fromId);
            return entry ? entry.Quantity : 0;
        }

        function productOptions() {
            let html = '<option value="">-- select product --</option>';
            products.forEach(p => {
                html += `<option value="${p.Id}">${p.Sku} - ${p.Name}</option>`;
            });
            return html;
        }

        function addRow() {
            const tbody = document.getElementById('itemsBody');
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>
                    <select name="Items[${rowIndex}].ProductId" class="form-select product-select">${productOptions()}</select>
                </td>
                <td><input name="Items[${rowIndex}].Quantity" type="number" step="0.01" min="0.01" class="form-control qty-input" value="1" /></td>
                <td class="available-cell text-muted">&mdash;</td>
                <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger remove-row"><i class="fas fa-times"></i></button></td>
            `;
            tbody.appendChild(tr);
            rowIndex++;
            wireRow(tr);
        }

        function wireRow(tr) {
            const select = tr.querySelector('.product-select');
            const available = tr.querySelector('.available-cell');

            function updateAvailable() {
                const product = products.find(p => p.Id == select.value);
                available.textContent = product ? stockInFrom(product).toFixed(2) : '—';
            }

            select.addEventListener('change', updateAvailable);
            tr.querySelector('.remove-row').addEventListener('click', () => tr.remove());

            initSelect2(tr);
            updateAvailable();
        }

        document.getElementById('addRow').addEventListener('click', addRow);
        if (fromWarehouseEl.tagName === 'SELECT') {
            fromWarehouseEl.addEventListener('change', () => {
                document.querySelectorAll('#itemsBody tr').forEach(tr => {
                    const select = tr.querySelector('.product-select');
                    const available = tr.querySelector('.available-cell');
                    const product = products.find(p => p.Id == select.value);
                    available.textContent = product ? stockInFrom(product).toFixed(2) : '—';
                });
            });
        }
        addRow();
    </script>
    <partial name="_ValidationScriptsPartial" />
}
