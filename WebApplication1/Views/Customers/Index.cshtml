@model List<Customer>
@{
    ViewData["Title"] = "Customers";
}

@section Toolbar {
    @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager) || User.IsInRole(Roles.SalesOfficer))
    {
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> New Customer</a>
    }
}

<div class="card">
    <div class="card-header">
        <form method="get" class="d-flex gap-2">
            <input type="text" name="search" value="@ViewData["Search"]" class="form-control form-control-sm" placeholder="Search customers..." />
            <button class="btn btn-sm btn-outline-secondary" type="submit"><i class="fas fa-search"></i></button>
        </form>
    </div>
    @if (ViewData["WarehouseScoped"] is true)
    {
        <div class="alert alert-info py-2 px-3 mb-0 rounded-0 border-0 small"><i class="fas fa-circle-info me-1"></i>Outstanding due shown is limited to sales invoices from your assigned warehouse(s).</div>
    }
    <div class="card-body p-0 table-responsive-card">
        <table class="table table-striped table-hover mb-0 data-table" id="customerTable">
            <thead><tr><th>Name</th><th>Contact</th><th>Phone</th><th>Email</th><th class="text-end">Outstanding Due</th><th data-filter="select">Status</th><th data-filter="false"></th></tr></thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr class="clickable-row" data-href="@Url.Action("Details", new { id = c.Id })">
                    <td><a asp-action="Details" asp-route-id="@c.Id" class="fw-semibold">@c.Name</a></td>
                    <td>@c.ContactPerson</td>
                    <td>@c.Phone</td>
                    <td>@c.Email</td>
                    <td class="text-end fw-semibold @(c.OutstandingDue > 0 ? "text-danger" : "text-success")">@c.OutstandingDue.ToString("C")</td>
                    <td>
                        @if (c.IsActive) { <span class="badge text-bg-success">Active</span> }
                        else { <span class="badge text-bg-secondary">Inactive</span> }
                    </td>
                    <td class="text-end">
                        <div class="table-actions">
                            <a asp-action="Ledger" asp-route-partyId="@c.Id" class="btn btn-sm btn-outline-secondary" title="View customer ledger"><i class="fas fa-book"></i></a>
                            @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager) || User.IsInRole(Roles.SalesOfficer))
                            {
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary" title="Edit customer"><i class="fas fa-pen"></i></a>
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="confirm-delete" data-confirm-message="Delete this customer?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete customer"><i class="fas fa-trash"></i></button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<style>
    #customerTable tbody tr.clickable-row { cursor: pointer; }
    #customerTable tbody tr.clickable-row:hover { background-color: var(--bs-tertiary-bg); }
</style>

@section Scripts {
    <script>
        document.getElementById('customerTable').addEventListener('click', function (e) {
            if (e.target.closest('a, button, input, form')) return;
            var row = e.target.closest('tr.clickable-row');
            if (row && row.dataset.href) {
                window.location.href = row.dataset.href;
            }
        });
    </script>
}
