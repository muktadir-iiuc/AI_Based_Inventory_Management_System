@model PurchaseInvoiceCreateViewModel
@{
    ViewData["Title"] = $"Edit Purchase Invoice {ViewData["InvoiceNumber"]}";
    var supplierList = (SelectList)ViewData["Suppliers"]!;
    var warehouseList = (SelectList)ViewData["Warehouses"]!;
    var warehouseScoped = (bool)ViewData["WarehouseScoped"]!;
    var unitList = (SelectList)ViewData["Units"]!;
}

<div class="alert alert-info py-2 small mb-3"><i class="fas fa-circle-info"></i> Editing keeps the invoice number <strong>@ViewData["InvoiceNumber"]</strong> — saving reverses the old lines' stock/accounting effect and posts the lines below fresh.</div>

<form asp-action="Edit" method="post" id="invoiceForm">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-lg-9">
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title">Invoice Details</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="SupplierId" class="form-label required-asterisk"></label>
                            <div class="d-flex gap-2">
                                <select asp-for="SupplierId" asp-items="supplierList" class="form-select">
                                    <option value="">-- select supplier --</option>
                                </select>
                                <button type="button" class="btn btn-outline-primary text-nowrap" data-bs-toggle="modal" data-bs-target="#quickAddSupplierModal" title="Add a new supplier">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                            <div class="small mt-1 d-none" id="supplierDue"></div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="WarehouseId" class="form-label required-asterisk"></label>
                            @if (warehouseScoped)
                            {
                                <input class="form-control" value="@warehouseList.FirstOrDefault(w => w.Selected)?.Text" readonly />
                                <input type="hidden" asp-for="WarehouseId" />
                            }
                            else
                            {
                                <select asp-for="WarehouseId" asp-items="warehouseList" class="form-select">
                                    <option value="">-- select warehouse --</option>
                                </select>
                            }
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Date" class="form-label required-asterisk"></label>
                            <input asp-for="Date" class="form-control" type="date" />
                        </div>
                        <div class="col-12 mb-0">
                            <label asp-for="Notes" class="form-label"></label>
                            <input asp-for="Notes" class="form-control" placeholder="Optional note for this invoice" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h3 class="card-title mb-0">Line Items</h3>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="addRow"><i class="fas fa-plus"></i> Add product line</button>
                </div>
                <div class="card-body p-0 table-responsive-card">
                    <table class="table table-hover align-middle mb-0" id="itemsTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 3%">#</th>
                                <th style="width: 25%">Product</th>
                                <th style="width: 12%">Category</th>
                                <th style="width: 10%">Quantity</th>
                                <th style="width: 12%">Unit Cost</th>
                                <th style="width: 13%">Sale Price</th>
                                <th style="width: 17%" class="text-end">Line Total</th>
                                <th style="width: 5%"></th>
                            </tr>
                        </thead>
                        <tbody id="itemsBody"></tbody>
                    </table>
                    <div id="emptyState" class="text-center text-muted py-4 d-none">
                        No product lines yet — click "Add product line" to get started.
                    </div>
                </div>
                <div class="card-footer">
                    <div class="form-text mb-0">Each line becomes its own batch: this Sale Price is what that specific batch will sell at, independent of any other purchase's price for the same product.</div>
                </div>
            </div>
        </div>

        <div class="col-lg-3">
            <div class="card position-sticky" style="top: 1rem;">
                <div class="card-header">
                    <h3 class="card-title">Summary</h3>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-7 text-muted fw-normal">Product lines</dt>
                        <dd class="col-5 text-end" id="summaryLineCount">0</dd>
                        <dt class="col-7 text-muted fw-normal">Total quantity</dt>
                        <dd class="col-5 text-end" id="summaryQty">0</dd>
                    </dl>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Grand Total</span>
                        <span class="fs-3 fw-bold text-primary" id="grandTotal">0.00</span>
                    </div>
                    <div class="d-none" id="supplierDueSummary">
                        <hr />
                        <dl class="row mb-0">
                            <dt class="col-7 text-muted fw-normal">Previous due <span class="small">(excl. this invoice)</span></dt>
                            <dd class="col-5 text-end" id="supplierPreviousDue"></dd>
                            <dt class="col-7 fw-semibold">Due after this edit</dt>
                            <dd class="col-5 text-end fw-semibold" id="supplierDueAfter"></dd>
                        </dl>
                    </div>
                </div>
                <div class="card-footer d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a asp-action="Details" asp-route-id="@ViewContext.RouteData.Values["id"]" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</form>

<div class="modal fade" id="quickAddProductModal" tabindex="-1" aria-labelledby="quickAddProductModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="quickAddProductModalLabel">Add New Product</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-danger small mb-2 d-none" id="quickProductError"></div>
                <div class="mb-2">
                    <label class="form-label required-asterisk">Name</label>
                    <input type="text" class="form-control" id="quickProductName" maxlength="150" data-enter-submit />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-2">
                        <label class="form-label required-asterisk">Category</label>
                        <select class="form-select" id="quickProductCategory"></select>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="form-label required-asterisk">Unit</label>
                        <select class="form-select" id="quickProductUnit" asp-items="unitList">
                            <option value="">-- select unit --</option>
                        </select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-2">
                        <label class="form-label">Cost Price</label>
                        <input type="number" step="0.01" min="0" class="form-control" id="quickProductCost" value="0" data-enter-submit />
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="form-label">Sale Price</label>
                        <input type="number" step="0.01" min="0" class="form-control" id="quickProductSale" value="0" data-enter-submit />
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="form-label">Reorder Level</label>
                        <input type="number" step="0.01" min="0" class="form-control" id="quickProductReorder" value="10" data-enter-submit />
                    </div>
                </div>
                <div class="mb-0">
                    <label class="form-label">Description</label>
                    <textarea class="form-control" rows="2" maxlength="500" id="quickProductDescription"></textarea>
                </div>
                <div class="form-text mt-2">The SKU is generated automatically from the category.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveQuickProduct">Save Product</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="quickAddSupplierModal" tabindex="-1" aria-labelledby="quickAddSupplierModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="quickAddSupplierModalLabel">Add New Supplier</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-danger small mb-2 d-none" id="quickSupplierError"></div>
                <div class="mb-2">
                    <label class="form-label required-asterisk">Name</label>
                    <input type="text" class="form-control" id="quickSupplierName" data-enter-submit />
                </div>
                <div class="mb-2">
                    <label class="form-label">Contact Person</label>
                    <input type="text" class="form-control" id="quickSupplierContact" data-enter-submit />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-2">
                        <label class="form-label">Phone</label>
                        <input type="text" class="form-control" id="quickSupplierPhone" data-enter-submit />
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" id="quickSupplierEmail" data-enter-submit />
                    </div>
                </div>
                <div class="mb-0">
                    <label class="form-label">Address</label>
                    <textarea class="form-control" rows="2" id="quickSupplierAddress"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveQuickSupplier">Save Supplier</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const products = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["Products"]));
        const existingLines = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Items));
        let rowIndex = 0;

        function productOptions(selectedId) {
            let html = '<option value="">-- select product --</option>';
            products.forEach(p => {
                const sel = (selectedId && selectedId == p.Id) ? 'selected' : '';
                html += `<option value="${p.Id}" data-cost="${p.CostPrice}" data-sale="${p.SuggestedSalePrice}" data-symbol="${p.Symbol}" data-category="${p.Category || ''}" ${sel}>${productOptionLabel(p)}</option>`;
            });
            return html;
        }

        function updateEmptyState() {
            const hasRows = document.querySelectorAll('#itemsBody tr').length > 0;
            document.getElementById('itemsTable').classList.toggle('d-none', !hasRows);
            document.getElementById('emptyState').classList.toggle('d-none', hasRows);
        }

        function renumberRows() {
            document.querySelectorAll('#itemsBody tr').forEach((tr, i) => {
                tr.querySelector('.row-number').textContent = i + 1;
            });
        }

        function addRow(line) {
            const tbody = document.getElementById('itemsBody');
            const tr = document.createElement('tr');
            const productId = line ? line.ProductId : null;
            const qty = line ? line.Quantity : 1;
            const cost = line ? line.UnitPrice : 0;
            const sale = line ? line.SalePrice : 0;
            tr.innerHTML = `
                <td class="row-number text-muted"></td>
                <td>
                    <div class="d-flex gap-1 align-items-center">
                        <div class="flex-grow-1" style="min-width: 0;">
                            <select name="Items[${rowIndex}].ProductId" class="form-select product-select">${productOptions(productId)}</select>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary quick-add-product" title="Product not listed? Add a new one"><i class="fas fa-plus"></i></button>
                    </div>
                </td>
                <td class="category-cell text-muted">&mdash;</td>
                <td><input name="Items[${rowIndex}].Quantity" type="number" step="1" min="1" class="form-control qty-input" value="${qty}" /></td>
                <td><input name="Items[${rowIndex}].UnitPrice" type="number" step="0.01" min="0" class="form-control price-input" value="${cost}" /></td>
                <td><input name="Items[${rowIndex}].SalePrice" type="number" step="0.01" min="0" class="form-control sale-price-input" value="${sale}" /></td>
                <td class="text-end line-total fw-semibold">0.00</td>
                <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger remove-row" title="Remove line"><i class="fas fa-times"></i></button></td>
            `;
            tbody.appendChild(tr);
            rowIndex++;

            if (line) {
                const opt = tr.querySelector('.product-select').selectedOptions[0];
                const category = opt && opt.value ? opt.dataset.category : '';
                const categoryCell = tr.querySelector('.category-cell');
                categoryCell.textContent = category || '—';
                categoryCell.classList.toggle('text-muted', !category);
            }

            wireRow(tr);
            renumberRows();
            updateEmptyState();
            recalc();
            return tr;
        }

        function wireRow(tr) {
            const select = tr.querySelector('.product-select');
            const qty = tr.querySelector('.qty-input');
            const price = tr.querySelector('.price-input');
            const salePrice = tr.querySelector('.sale-price-input');
            const categoryCell = tr.querySelector('.category-cell');

            const applyProductSelection = () => {
                const opt = select.options[select.selectedIndex];
                price.value = opt && opt.value ? (opt.dataset.cost || 0) : 0;
                salePrice.value = opt && opt.value ? (opt.dataset.sale || 0) : 0;
                const category = opt && opt.value ? opt.dataset.category : '';
                categoryCell.textContent = category || '—';
                categoryCell.classList.toggle('text-muted', !category);
                recalc();
            };

            // Rebuilds this row's Product list from the current `products` array (keeping the
            // selection) — called for every row once the quick-add modal saves a new product.
            tr.refreshProductOptions = (selectedId) => {
                select.innerHTML = productOptions(selectedId);
                if (typeof jQuery !== 'undefined') {
                    const $select = jQuery(select);
                    if ($select.hasClass('select2-hidden-accessible')) {
                        $select.select2('destroy');
                    }
                    // Through the shared helper, not a bare .select2() — see the
                    // select2Target tagging note in site.js's initSelect2.
                    initSelect2(tr);
                }
            };

            // Selects a just-created product in this row, filling in its prices and category
            // like a normal pick.
            tr.selectNewProduct = (product) => {
                tr.refreshProductOptions(product.Id);
                applyProductSelection();
            };

            tr.querySelector('.quick-add-product').addEventListener('click', () => {
                const current = products.find(p => p.Id == select.value);
                openQuickAddProduct(tr, current ? current.CategoryId : null);
            });

            select.addEventListener('change', applyProductSelection);
            qty.addEventListener('input', recalc);
            price.addEventListener('input', recalc);
            tr.querySelector('.remove-row').addEventListener('click', () => {
                tr.remove();
                renumberRows();
                updateEmptyState();
                recalc();
            });

            initSelect2(tr);

            // Select2 replaces the native dropdown UI; its own selection events fire more
            // reliably across browsers than the plain 'change' event once it's active. Only
            // reset the price suggestions on a genuine user pick, not the initial prefill.
            if (typeof jQuery !== 'undefined') {
                jQuery(select).on('select2:select select2:clear', applyProductSelection);
            }
        }

        function recalc() {
            let grand = 0;
            let totalQty = 0;
            const rows = document.querySelectorAll('#itemsBody tr');
            rows.forEach(tr => {
                const qty = parseFloat(tr.querySelector('.qty-input').value) || 0;
                const price = parseFloat(tr.querySelector('.price-input').value) || 0;
                const total = qty * price;
                tr.querySelector('.line-total').textContent = total.toFixed(2);
                grand += total;
                totalQty += qty;
            });
            document.getElementById('grandTotal').textContent = grand.toFixed(2);
            document.getElementById('summaryLineCount').textContent = rows.length;
            document.getElementById('summaryQty').textContent = totalQty.toFixed(2).replace(/\.00$/, '');
        }

        // Only the explicit "Add product line" click focuses the new row's Product box (and,
        // via site.js's global open-on-focus handler, opens its dropdown) — rows prefilled
        // from the invoice being edited, and added automatically below, leave focus alone.
        document.getElementById('addRow').addEventListener('click', () => {
            const tr = addRow(null);
            const productSelect = tr.querySelector('.product-select');
            const selection = jQuery(productSelect).next('.select2-container').find('.select2-selection')[0];
            if (selection) {
                selection.focus();
            }
        });

        // Quick-add product: opened from a line item's "+" button when the product being
        // purchased isn't in the catalog yet. On save, the new product joins the page's
        // `products` list, every row's Product dropdown is rebuilt to offer it (keeping each
        // row's selection), and it's selected in the row that opened the modal.
        const openQuickAddProduct = (function () {
            const categories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["Categories"]));
            const modalEl = document.getElementById('quickAddProductModal');
            const nameInput = document.getElementById('quickProductName');
            const categoryInput = document.getElementById('quickProductCategory');
            const unitInput = document.getElementById('quickProductUnit');
            const costInput = document.getElementById('quickProductCost');
            const saleInput = document.getElementById('quickProductSale');
            const reorderInput = document.getElementById('quickProductReorder');
            const descriptionInput = document.getElementById('quickProductDescription');
            const errorEl = document.getElementById('quickProductError');
            const saveBtn = document.getElementById('saveQuickProduct');
            const token = document.querySelector('#invoiceForm input[name="__RequestVerificationToken"]').value;
            const modal = new bootstrap.Modal(modalEl);
            let targetRow = null;

            let categoryHtml = '<option value="">-- select category --</option>';
            categories.forEach(c => {
                categoryHtml += `<option value="${c.Id}">${c.Name}</option>`;
            });
            categoryInput.innerHTML = categoryHtml;

            // Initialized here (before site.js's global initSelect2 runs on DOMContentLoaded,
            // which then skips them) so their dropdowns render inside the modal — attached to
            // <body> as usual, Bootstrap's modal focus trap would stop the search box taking focus.
            if (typeof jQuery !== 'undefined' && jQuery.fn.select2) {
                [categoryInput, unitInput].forEach(el => {
                    const $el = jQuery(el);
                    $el.select2({ width: '100%', dropdownParent: jQuery(modalEl) });
                    $el.next('.select2-container').find('.select2-selection').data('select2Target', $el);
                });
            }

            function setSelectValue(el, value) {
                el.value = value ?? '';
                if (typeof jQuery !== 'undefined') {
                    jQuery(el).trigger('change.select2');
                }
            }

            function resetForm() {
                nameInput.value = '';
                descriptionInput.value = '';
                costInput.value = 0;
                saleInput.value = 0;
                reorderInput.value = 10;
                setSelectValue(categoryInput, '');
                setSelectValue(unitInput, '');
                errorEl.classList.add('d-none');
                errorEl.textContent = '';
            }

            function showError(message) {
                errorEl.textContent = message;
                errorEl.classList.remove('d-none');
            }

            modalEl.addEventListener('shown.bs.modal', () => nameInput.focus());

            // Focus moves on only once the modal has fully closed — Bootstrap returns focus to the
            // "+" button that opened it on hide, which would override an earlier focus() call.
            let focusAfterClose = null;
            modalEl.addEventListener('hidden.bs.modal', () => {
                resetForm();
                targetRow = null;
                if (focusAfterClose) {
                    focusAfterClose.focus();
                    focusAfterClose = null;
                }
            });

            async function saveProduct() {
                const name = nameInput.value.trim();
                const categoryId = parseInt(categoryInput.value, 10) || 0;
                const unitId = parseInt(unitInput.value, 10) || 0;
                if (!name) {
                    showError('Enter a product name.');
                    nameInput.focus();
                    return;
                }
                if (!categoryId) {
                    showError('Select a category.');
                    return;
                }
                if (!unitId) {
                    showError('Select a unit of measure.');
                    return;
                }

                saveBtn.disabled = true;
                try {
                    const res = await fetch('@Url.Action("QuickCreate", "Products")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                        body: JSON.stringify({
                            name: name,
                            categoryId: categoryId,
                            unitOfMeasureId: unitId,
                            costPrice: parseFloat(costInput.value) || 0,
                            salePrice: parseFloat(saleInput.value) || 0,
                            reorderLevel: parseFloat(reorderInput.value) || 0,
                            description: descriptionInput.value.trim() || null
                        })
                    });
                    const data = await res.json();
                    if (!data.ok) {
                        showError(data.error || 'Could not add this product.');
                        return;
                    }

                    const product = {
                        Id: data.id,
                        Sku: data.sku,
                        Name: data.name,
                        CostPrice: data.costPrice,
                        SuggestedSalePrice: data.salePrice,
                        Symbol: data.symbol,
                        CategoryId: data.categoryId,
                        Category: data.category
                    };
                    products.push(product);
                    products.sort((a, b) => a.Name.localeCompare(b.Name));

                    const row = targetRow && document.body.contains(targetRow) ? targetRow : null;
                    document.querySelectorAll('#itemsBody tr').forEach(tr => {
                        if (tr !== row) {
                            tr.refreshProductOptions(tr.querySelector('.product-select').value);
                        }
                    });
                    if (row) {
                        row.selectNewProduct(product);
                        focusAfterClose = row.querySelector('.qty-input');
                    }
                    modal.hide();
                } catch {
                    showError('Unable to reach the server. Please try again.');
                } finally {
                    saveBtn.disabled = false;
                }
            }

            saveBtn.addEventListener('click', saveProduct);
            modalEl.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' && e.target.matches('input[data-enter-submit]')) {
                    e.preventDefault();
                    saveProduct();
                }
            });

            return function (row, categoryId) {
                targetRow = row;
                setSelectValue(categoryInput, categoryId);
                modal.show();
            };
        })();

        if (existingLines.length > 0) {
            existingLines.forEach(line => addRow(line));
        } else {
            addRow(null);
        }
    </script>
    <script>
        (function () {
            const supplierSelect = document.getElementById('SupplierId');
            const modalEl = document.getElementById('quickAddSupplierModal');
            const nameInput = document.getElementById('quickSupplierName');
            const contactInput = document.getElementById('quickSupplierContact');
            const phoneInput = document.getElementById('quickSupplierPhone');
            const emailInput = document.getElementById('quickSupplierEmail');
            const addressInput = document.getElementById('quickSupplierAddress');
            const errorEl = document.getElementById('quickSupplierError');
            const saveBtn = document.getElementById('saveQuickSupplier');
            const token = document.querySelector('#invoiceForm input[name="__RequestVerificationToken"]').value;
            const modal = new bootstrap.Modal(modalEl);

            function resetForm() {
                [nameInput, contactInput, phoneInput, emailInput, addressInput].forEach(el => el.value = '');
                errorEl.classList.add('d-none');
                errorEl.textContent = '';
            }

            function showError(message) {
                errorEl.textContent = message;
                errorEl.classList.remove('d-none');
            }

            modalEl.addEventListener('shown.bs.modal', () => nameInput.focus());
            modalEl.addEventListener('hidden.bs.modal', resetForm);

            async function saveSupplier() {
                const name = nameInput.value.trim();
                if (!name) {
                    showError('Enter a supplier name.');
                    nameInput.focus();
                    return;
                }

                saveBtn.disabled = true;
                try {
                    const res = await fetch('@Url.Action("QuickCreate", "Suppliers")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                        body: JSON.stringify({
                            name: name,
                            contactPerson: contactInput.value.trim() || null,
                            phone: phoneInput.value.trim() || null,
                            email: emailInput.value.trim() || null,
                            address: addressInput.value.trim() || null
                        })
                    });
                    const data = await res.json();
                    if (!data.ok) {
                        showError(data.error || 'Could not add this supplier.');
                        return;
                    }

                    const opt = document.createElement('option');
                    opt.value = data.id;
                    opt.textContent = data.name;
                    supplierSelect.appendChild(opt);
                    supplierSelect.value = data.id;

                    const $select = jQuery(supplierSelect);
                    if ($select.hasClass('select2-hidden-accessible')) {
                        $select.select2('destroy');
                    }
                    initSelect2(supplierSelect);
                    supplierDueWidget.refresh();

                    modal.hide();
                } catch {
                    showError('Unable to reach the server. Please try again.');
                } finally {
                    saveBtn.disabled = false;
                }
            }

            saveBtn.addEventListener('click', saveSupplier);
            modalEl.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' && e.target.matches('input')) {
                    e.preventDefault();
                    saveSupplier();
                }
            });
        })();
