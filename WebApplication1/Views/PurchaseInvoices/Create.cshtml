@model PurchaseInvoiceCreateViewModel
@{
    ViewData["Title"] = "New Purchase Invoice";
    var supplierList = (SelectList)ViewData["Suppliers"]!;
    var warehouseList = (SelectList)ViewData["Warehouses"]!;
    var warehouseScoped = (bool)ViewData["WarehouseScoped"]!;
}

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post" id="invoiceForm">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="SupplierId" class="form-label required-asterisk"></label>
                    <select asp-for="SupplierId" asp-items="supplierList" class="form-select">
                        <option value="">-- select supplier --</option>
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="WarehouseId" class="form-label required-asterisk"></label>
                    @if (warehouseScoped)
                    {
                        <input class="form-control" value="@warehouseList.FirstOrDefault(w => w.Selected)?.Text" readonly />
                        <input type="hidden" asp-for="WarehouseId" />
                    }
                    else
                    {
                        <select asp-for="WarehouseId" asp-items="warehouseList" class="form-select">
                            <option value="">-- select warehouse --</option>
                        </select>
                    }
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="Date" class="form-label required-asterisk"></label>
                    <input asp-for="Date" class="form-control" type="date" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Notes" class="form-label"></label>
                    <input asp-for="Notes" class="form-control" />
                </div>
            </div>

            <table class="table table-bordered" id="itemsTable">
                <thead>
                    <tr>
                        <th style="width: 32%">Product</th>
                        <th style="width: 13%">Quantity</th>
                        <th style="width: 13%">Unit Cost</th>
                        <th style="width: 15%">Sale Price</th>
                        <th style="width: 17%" class="text-end">Line Total</th>
                        <th style="width: 5%"></th>
                    </tr>
                </thead>
                <tbody id="itemsBody"></tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="text-end fw-bold">Grand Total</td>
                        <td class="text-end fw-bold" id="grandTotal">0.00</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
            <div class="form-text mb-3">Each line becomes its own batch: this Sale Price is what that specific batch will sell at, independent of any other purchase's price for the same product.</div>

            <button type="button" class="btn btn-outline-secondary btn-sm mb-3" id="addRow"><i class="fas fa-plus"></i> Add product line</button>

            <div>
                <button type="submit" class="btn btn-primary">Post Purchase Invoice</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const products = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["Products"]));
        let rowIndex = 0;

        function productOptions(selectedId) {
            let html = '<option value="">-- select product --</option>';
            products.forEach(p => {
                const sel = (selectedId && selectedId == p.Id) ? 'selected' : '';
                html += `<option value="${p.Id}" data-cost="${p.CostPrice}" data-sale="${p.SuggestedSalePrice}" data-symbol="${p.Symbol}" ${sel}>${p.Sku} - ${p.Name}</option>`;
            });
            return html;
        }

        function addRow() {
            const tbody = document.getElementById('itemsBody');
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>
                    <select name="Items[${rowIndex}].ProductId" class="form-select product-select">${productOptions()}</select>
                </td>
                <td><input name="Items[${rowIndex}].Quantity" type="number" step="0.01" min="0.01" class="form-control qty-input" value="1" /></td>
                <td><input name="Items[${rowIndex}].UnitPrice" type="number" step="0.01" min="0" class="form-control price-input" value="0" /></td>
                <td><input name="Items[${rowIndex}].SalePrice" type="number" step="0.01" min="0" class="form-control sale-price-input" value="0" /></td>
                <td class="text-end line-total">0.00</td>
                <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger remove-row"><i class="fas fa-times"></i></button></td>
            `;
            tbody.appendChild(tr);
            rowIndex++;
            wireRow(tr);
        }

        function wireRow(tr) {
            const select = tr.querySelector('.product-select');
            const qty = tr.querySelector('.qty-input');
            const price = tr.querySelector('.price-input');
            const salePrice = tr.querySelector('.sale-price-input');

            select.addEventListener('change', () => {
                const opt = select.options[select.selectedIndex];
                price.value = opt.dataset.cost || 0;
                salePrice.value = opt.dataset.sale || 0;
                recalc();
            });
            qty.addEventListener('input', recalc);
            price.addEventListener('input', recalc);
            tr.querySelector('.remove-row').addEventListener('click', () => {
                tr.remove();
                recalc();
            });

            initSelect2(tr);
        }

        function recalc() {
            let grand = 0;
            document.querySelectorAll('#itemsBody tr').forEach(tr => {
                const qty = parseFloat(tr.querySelector('.qty-input').value) || 0;
                const price = parseFloat(tr.querySelector('.price-input').value) || 0;
                const total = qty * price;
                tr.querySelector('.line-total').textContent = total.toFixed(2);
                grand += total;
            });
            document.getElementById('grandTotal').textContent = grand.toFixed(2);
        }

        document.getElementById('addRow').addEventListener('click', addRow);
        addRow();
    </script>
    <partial name="_ValidationScriptsPartial" />
}
