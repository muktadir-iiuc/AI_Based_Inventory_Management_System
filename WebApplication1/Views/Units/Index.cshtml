@model List<UnitOfMeasure>
@{
    ViewData["Title"] = "Units of Measure";
}

@section Toolbar {
    @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager) || User.IsInRole(Roles.PurchaseOfficer))
    {
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> New Unit</a>
    }
}

<div class="card">
    <div class="card-body p-0 table-responsive-card">
        <table class="table table-striped table-hover mb-0 data-table">
            <thead><tr><th>Name</th><th>Symbol</th><th data-filter="select">Status</th><th data-filter="false"></th></tr></thead>
            <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.Name</td>
                    <td>@u.Symbol</td>
                    <td>
                        @if (u.IsActive) { <span class="badge text-bg-success">Active</span> }
                        else { <span class="badge text-bg-secondary">Inactive</span> }
                    </td>
                    <td class="text-end">
                        @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager) || User.IsInRole(Roles.PurchaseOfficer))
                        {
                            <div class="table-actions">
                                <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary" title="Edit unit"><i class="fas fa-pen"></i></a>
                                <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="confirm-delete" data-confirm-message="Delete this unit?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete unit"><i class="fas fa-trash"></i></button>
                                </form>
                            </div>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
