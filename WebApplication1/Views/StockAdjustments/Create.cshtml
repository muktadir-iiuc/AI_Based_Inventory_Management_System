@using WebApplication1.Extensions
@model StockAdjustmentCreateViewModel
@{
    ViewData["Title"] = "New Stock Adjustment Request";
    var warehouseList = (SelectList)ViewData["Warehouses"]!;
    var reasons = Html.GetEnumSelectList<StockAdjustmentReason>();
}

<div class="alert alert-info py-2 small">
    <i class="fas fa-circle-info me-1"></i>
    This is a <strong>request</strong>: stock does not change until a Manager approves it. If the Manager rejects it, nothing is changed.
</div>

<form asp-action="Create" method="post" id="adjustmentForm">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-lg-9">
            <div class="card mb-3">
                <div class="card-header"><h3 class="card-title">Request Details</h3></div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="WarehouseId" class="form-label required-asterisk">Warehouse</label>
                            <select asp-for="WarehouseId" asp-items="warehouseList" id="warehouseId" class="form-select">
                                <option value="">-- select warehouse --</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Reason" class="form-label required-asterisk"></label>
                            <select asp-for="Reason" asp-items="reasons" class="form-select">
                                <option value="">-- select reason --</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Notes" class="form-label"></label>
                            <input asp-for="Notes" class="form-control" placeholder="Details for the approver (required for 'Other')" maxlength="500" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h3 class="card-title mb-0">Line Items</h3>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="addRow"><i class="fas fa-plus"></i> Add product line</button>
                </div>
                <div class="card-body p-0 table-responsive-card">
                    <table class="table table-hover align-middle mb-0" id="itemsTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 3%">#</th>
                                <th style="width: 30%">Product</th>
                                <th style="width: 15%">Adjustment</th>
                                <th style="width: 12%">Quantity</th>
                                <th style="width: 13%">Unit Cost</th>
                                <th style="width: 13%">Sale Price</th>
                                <th style="width: 10%">Available</th>
                                <th style="width: 4%"></th>
                            </tr>
                        </thead>
                        <tbody id="itemsBody"></tbody>
                    </table>
                </div>
                <div class="card-footer small text-muted">
                    <strong>Decrease</strong> removes stock (oldest batches first, at their own cost).
                    <strong>Increase</strong> adds a new batch — enter what those units cost; sale price is optional and defaults to the product's default price.
                </div>
            </div>
        </div>

        <div class="col-lg-3">
            <div class="card position-sticky" style="top: 1rem;">
                <div class="card-header"><h3 class="card-title">Summary</h3></div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-7 text-muted fw-normal">Lines</dt>
                        <dd class="col-5 text-end" id="summaryLineCount">0</dd>
                        <dt class="col-7 text-muted fw-normal">Units added</dt>
                        <dd class="col-5 text-end text-success" id="summaryIncrease">0</dd>
                        <dt class="col-7 text-muted fw-normal">Units removed</dt>
                        <dd class="col-5 text-end text-danger" id="summaryDecrease">0</dd>
                    </dl>
                    <div class="alert alert-danger py-2 small mt-3 mb-0 d-none" id="shortageWarning">
                        <i class="fas fa-triangle-exclamation"></i> A decrease exceeds the available stock — lower the quantity.
                    </div>
                </div>
                <div class="card-footer d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Submit for Approval</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        const products = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["Products"]));
        const initialItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Items.Select(i => new { productId = i.ProductId, direction = (int)i.Direction, quantity = i.Quantity, unitCost = i.UnitCost, salePrice = i.SalePrice })));
        const warehouseEl = document.getElementById('warehouseId');
        let rowIndex = 0;

        function stockInWarehouse(product) {
            const id = parseInt(warehouseEl.value, 10);
            const entry = (product.Stocks || []).find(s => s.WarehouseId === id);
            return entry ? entry.Quantity : 0;
        }

        function productOptions() {
            let html = '<option value="">-- select product --</option>';
            products.forEach(p => { html += `<option value="${p.Id}">${p.Sku} - ${p.Name}</option>`; });
            return html;
        }

        function renumberRows() {
            document.querySelectorAll('#itemsBody tr').forEach((tr, i) => { tr.querySelector('.row-number').textContent = i + 1; });
        }

        function addRow(init) {
            const tr = document.createElement('tr');
            const i = rowIndex++;
            tr.innerHTML = `
                <td class="row-number text-muted"></td>
                <td><select name="Items[${i}].ProductId" class="form-select product-select">${productOptions()}</select></td>
                <td>
                    <select name="Items[${i}].Direction" class="form-select direction-select">
                        <option value="2">Decrease (−)</option>
                        <option value="1">Increase (+)</option>
                    </select>
                </td>
                <td><input name="Items[${i}].Quantity" type="number" step="1" min="1" class="form-control qty-input" value="1" /></td>
                <td><input name="Items[${i}].UnitCost" type="number" step="0.01" min="0" class="form-control cost-input" placeholder="Cost" /></td>
                <td><input name="Items[${i}].SalePrice" type="number" step="0.01" min="0" class="form-control price-input" placeholder="Optional" /></td>
                <td class="available-cell text-muted">&mdash;</td>
                <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger remove-row" title="Remove line"><i class="fas fa-times"></i></button></td>`;
            document.getElementById('itemsBody').appendChild(tr);
            wireRow(tr, init);
            renumberRows();
            recalc();
            return tr;
        }

        function wireRow(tr, init) {
            const select = tr.querySelector('.product-select');
            const direction = tr.querySelector('.direction-select');
            const qty = tr.querySelector('.qty-input');
            const cost = tr.querySelector('.cost-input');
            const price = tr.querySelector('.price-input');
            const available = tr.querySelector('.available-cell');

            function isIncrease() { return direction.value === '1'; }

            function refresh() {
                const product = products.find(p => p.Id == select.value);
                const stock = product ? stockInWarehouse(product) : null;
                available.textContent = stock === null ? '—' : stock.toFixed(2).replace(/\.?0+$/, '');
                cost.disabled = price.disabled = !isIncrease();
                cost.required = isIncrease();
                if (!isIncrease()) { cost.value = ''; price.value = ''; }
                const short = !isIncrease() && stock !== null && (parseFloat(qty.value) || 0) > stock;
                tr.classList.toggle('table-danger', short);
                available.classList.toggle('text-danger', short);
                available.classList.toggle('fw-semibold', short);
                recalc();
            }

            function onProductChosen() {
                const product = products.find(p => p.Id == select.value);
                // Pre-fill an increase from the product's default prices, but never overwrite what was typed.
                if (product && isIncrease()) {
                    if (!cost.value) cost.value = product.CostPrice;
                    if (!price.value) price.value = product.SalePrice;
                }
                refresh();
            }

            select.addEventListener('change', onProductChosen);
            direction.addEventListener('change', onProductChosen);
            qty.addEventListener('input', refresh);
            tr.querySelector('.remove-row').addEventListener('click', () => { tr.remove(); renumberRows(); recalc(); });

            initSelect2(tr);
            if (typeof jQuery !== 'undefined') {
                jQuery(select).on('select2:select select2:clear', onProductChosen);
                jQuery(direction).on('select2:select', onProductChosen);
            }

            if (init) {
                if (init.productId) select.value = init.productId;
                direction.value = String(init.direction || 2);
                if (init.quantity) qty.value = init.quantity;
                if (init.unitCost != null) cost.value = init.unitCost;
                if (init.salePrice != null) price.value = init.salePrice;
                if (typeof jQuery !== 'undefined') { jQuery(select).trigger('change.select2'); jQuery(direction).trigger('change.select2'); }
            }
            tr.refresh = refresh;
            refresh();
        }

        function recalc() {
            let inc = 0, dec = 0, short = false;
            const rows = document.querySelectorAll('#itemsBody tr');
            rows.forEach(tr => {
                const q = parseFloat(tr.querySelector('.qty-input').value) || 0;
                if (tr.querySelector('.direction-select').value === '1') inc += q; else dec += q;
                if (tr.classList.contains('table-danger')) short = true;
            });
            document.getElementById('summaryLineCount').textContent = rows.length;
            document.getElementById('summaryIncrease').textContent = inc.toFixed(2).replace(/\.?0+$/, '') || '0';
            document.getElementById('summaryDecrease').textContent = dec.toFixed(2).replace(/\.?0+$/, '') || '0';
            document.getElementById('shortageWarning').classList.toggle('d-none', !short);
        }

        function refreshAll() { document.querySelectorAll('#itemsBody tr').forEach(tr => tr.refresh && tr.refresh()); }
        warehouseEl.addEventListener('change', refreshAll);
        if (typeof jQuery !== 'undefined') { jQuery(warehouseEl).on('select2:select select2:clear', refreshAll); }

        document.getElementById('addRow').addEventListener('click', () => {
            const tr = addRow();
            const selection = jQuery(tr.querySelector('.product-select')).next('.select2-container').find('.select2-selection')[0];
            if (selection) selection.focus();
        });

        (initialItems.length ? initialItems : [null]).forEach(i => addRow(i));
    </script>
    <partial name="_ValidationScriptsPartial" />
}
