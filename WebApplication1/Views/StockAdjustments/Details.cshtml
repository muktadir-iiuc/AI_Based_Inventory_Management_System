@using WebApplication1.Extensions
@model StockAdjustment
@{
    ViewData["Title"] = $"Stock Adjustment {Model.AdjustmentNumber}";
    var canReview = ViewData["CanReview"] is true;
    var isRequester = ViewData["IsRequester"] is true;
    var available = (Dictionary<int, decimal>)ViewData["Available"]!;
    var isPending = Model.Status == StockAdjustmentStatus.Pending;
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header"><h3 class="card-title">Request</h3></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Request #</dt><dd class="col-7">@Model.AdjustmentNumber</dd>
                    <dt class="col-5">Warehouse</dt><dd class="col-7">@Model.Warehouse?.Name</dd>
                    <dt class="col-5">Reason</dt><dd class="col-7">@Model.Reason.GetDisplayName()</dd>
                    <dt class="col-5">Status</dt>
                    <dd class="col-7">
                        @switch (Model.Status)
                        {
                            case StockAdjustmentStatus.Pending: <span class="badge text-bg-warning"><i class="fas fa-hourglass-half"></i> Pending approval</span> break;
                            case StockAdjustmentStatus.Approved: <span class="badge text-bg-success"><i class="fas fa-check-circle"></i> Approved</span> break;
                            case StockAdjustmentStatus.Rejected: <span class="badge text-bg-danger"><i class="fas fa-circle-xmark"></i> Rejected</span> break;
                            default: <span class="badge text-bg-secondary"><i class="fas fa-ban"></i> Cancelled</span> break;
                        }
                    </dd>
                    <dt class="col-5">Requested by</dt><dd class="col-7">@Model.RequestedBy</dd>
                    <dt class="col-5">Requested</dt><dd class="col-7">@Model.RequestedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</dd>
                    @if (Model.ReviewedAt.HasValue)
                    {
                        <dt class="col-5">@(Model.Status == StockAdjustmentStatus.Cancelled ? "Cancelled by" : "Reviewed by")</dt><dd class="col-7">@Model.ReviewedBy</dd>
                        <dt class="col-5">@(Model.Status == StockAdjustmentStatus.Cancelled ? "Cancelled" : "Reviewed")</dt><dd class="col-7">@Model.ReviewedAt.Value.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <dt class="col-5">Notes</dt><dd class="col-7">@Model.Notes</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.ReviewNote))
                    {
                        <dt class="col-5">@(Model.Status == StockAdjustmentStatus.Rejected ? "Rejection reason" : "Review note")</dt><dd class="col-7">@Model.ReviewNote</dd>
                    }
                </dl>
            </div>
            <div class="card-footer">
                <a asp-action="Index" class="btn btn-secondary btn-sm">Back to list</a>
                @if (isPending && isRequester)
                {
                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline confirm-delete" data-confirm-message="Withdraw this adjustment request?">
                        <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fas fa-ban"></i> Withdraw request</button>
                    </form>
                }
            </div>
        </div>

        @if (isPending && canReview)
        {
            <div class="card mt-3 border-warning">
                <div class="card-header"><h3 class="card-title">Decision</h3></div>
                <div class="card-body">
                    <p class="small text-muted mb-3">
                        Approving applies every line to stock immediately (decreases are taken from the oldest batches first)
                        and posts the cost to the books. Rejecting changes nothing.
                    </p>
                    <label for="reviewNote" class="form-label small text-muted">Note <span class="text-muted">(required to reject)</span></label>
                    <textarea id="reviewNote" class="form-control form-control-sm mb-3" rows="3" maxlength="500" placeholder="Optional when approving"></textarea>
                    <div class="d-grid gap-2">
                        <form asp-action="Approve" asp-route-id="@Model.Id" method="post" id="approveForm">
                            <input type="hidden" name="reviewNote" class="note-mirror" />
                            <button type="submit" class="btn btn-success w-100"><i class="fas fa-check"></i> Approve</button>
                        </form>
                        <form asp-action="Reject" asp-route-id="@Model.Id" method="post" id="rejectForm">
                            <input type="hidden" name="reviewNote" class="note-mirror" />
                            <button type="submit" class="btn btn-outline-danger w-100"><i class="fas fa-xmark"></i> Reject</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-header"><h3 class="card-title">Lines</h3></div>
            <div class="card-body p-0 table-responsive-card">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Product</th><th>Adjustment</th><th class="text-end">Qty</th>
                            @if (isPending) { <th class="text-end">FIFO Available Now</th> }
                            <th class="text-end">@(Model.Status == StockAdjustmentStatus.Approved ? "Cost Applied" : "Unit Cost")</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var isDecrease = item.Direction == StockAdjustmentDirection.Decrease;
                        var stock = available.GetValueOrDefault(item.ProductId);
                        var short_ = isPending && isDecrease && item.Quantity > stock;
                        <tr class="@(short_ ? "table-danger" : "")">
                            <td>@item.Product?.Sku — @item.Product?.Name</td>
                            <td>
                                @if (isDecrease) { <span class="badge text-bg-danger"><i class="fas fa-arrow-down"></i> Decrease</span> }
                                else { <span class="badge text-bg-success"><i class="fas fa-arrow-up"></i> Increase</span> }
                            </td>
                            <td class="text-end">@item.Quantity.ToString("0.##") @item.Product?.UnitOfMeasure?.Symbol</td>
                            @if (isPending)
                            {
                                <td class="text-end @(short_ ? "fw-semibold text-danger" : "")">@stock.ToString("0.##")</td>
                            }
                            <td class="text-end">
                                @if (Model.Status == StockAdjustmentStatus.Approved)
                                {
                                    @item.AppliedCostTotal.ToString("C")
                                }
                                else if (!isDecrease)
                                {
                                    @item.UnitCost?.ToString("C")
                                }
                                else
                                {
                                    <span class="text-muted small">FIFO batch cost</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (isPending && Model.Items.Any(i => i.Direction == StockAdjustmentDirection.Decrease && i.Quantity > available.GetValueOrDefault(i.ProductId)))
            {
                <div class="card-footer">
                    <div class="text-danger small"><i class="fas fa-triangle-exclamation"></i> Some decreases now exceed the available stock, so this request can no longer be approved as filed — reject it.</div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var note = document.getElementById('reviewNote');
            if (!note) return;
            // The two decision buttons are separate forms; mirror the shared note into each on submit.
            function mirror() {
                document.querySelectorAll('.note-mirror').forEach(function (el) { el.value = note.value; });
            }
            document.getElementById('approveForm').addEventListener('submit', function (e) {
                mirror();
                if (!confirm('Approve this request? Stock will be changed immediately.')) e.preventDefault();
            });
            document.getElementById('rejectForm').addEventListener('submit', function (e) {
                mirror();
                if (!note.value.trim()) {
                    e.preventDefault();
                    note.classList.add('is-invalid');
                    note.focus();
                    return;
                }
                if (!confirm('Reject this request? No stock will be changed.')) e.preventDefault();
            });
            note.addEventListener('input', function () { note.classList.remove('is-invalid'); });
        })();
    </script>
}
