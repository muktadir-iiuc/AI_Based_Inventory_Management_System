@using WebApplication1.Extensions
@model List<StockAdjustment>
@{
    ViewData["Title"] = "Stock Adjustments";
    var status = ViewData["Status"] as StockAdjustmentStatus?;
    var canReview = ViewData["CanReview"] is true;
    var pendingCount = (int)ViewData["PendingCount"]!;
    var canRequest = User.IsInRole(Roles.SalesOfficer) || User.IsInRole(Roles.PurchaseOfficer);
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

@section Toolbar {
    @if (canRequest)
    {
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> New Adjustment Request</a>
    }
}

@if (canReview && pendingCount > 0 && status != StockAdjustmentStatus.Pending)
{
    <div class="alert alert-warning py-2 d-flex align-items-center justify-content-between">
        <span><i class="fas fa-hourglass-half me-1"></i> <strong>@pendingCount</strong> adjustment request(s) waiting for your approval.</span>
        <a asp-action="Index" asp-route-status="@StockAdjustmentStatus.Pending" class="btn btn-sm btn-warning">Review pending</a>
    </div>
}

<div class="card">
    <div class="card-header">
        <ul class="nav nav-pills">
            <li class="nav-item"><a class="nav-link py-1 @(status is null ? "active" : "")" asp-action="Index">All</a></li>
            @foreach (var s in Enum.GetValues<StockAdjustmentStatus>())
            {
                <li class="nav-item">
                    <a class="nav-link py-1 @(status == s ? "active" : "")" asp-action="Index" asp-route-status="@s">
                        @s
                        @if (s == StockAdjustmentStatus.Pending && pendingCount > 0)
                        {
                            <span class="badge text-bg-warning ms-1">@pendingCount</span>
                        }
                    </a>
                </li>
            }
        </ul>
    </div>
    <div class="card-body p-0 table-responsive-card">
        <table class="table table-striped table-hover mb-0 data-table" id="adjustmentTable">
            <thead>
                <tr>
                    <th>Request #</th><th data-filter="select">Warehouse</th><th data-filter="select">Reason</th>
                    <th class="text-end" data-filter="false">Lines</th><th>Requested By</th><th data-filter="date">Requested</th>
                    <th data-filter="select">Status</th><th>Reviewed By</th>
                    @if (canReview) { <th class="text-end" data-filter="false">Actions</th> }
                </tr>
            </thead>
            <tbody>
            @foreach (var a in Model)
            {
                <tr class="clickable-row" data-href="@Url.Action("Details", new { id = a.Id })">
                    <td><a asp-action="Details" asp-route-id="@a.Id" class="fw-semibold">@a.AdjustmentNumber</a></td>
                    <td>@a.Warehouse?.Name</td>
                    <td>@a.Reason.GetDisplayName()</td>
                    <td class="text-end">@a.Items.Count</td>
                    <td>@a.RequestedBy</td>
                    <td data-date="@a.RequestedAt.ToLocalTime().ToString("yyyy-MM-dd")">@a.RequestedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                    <td>
                        @switch (a.Status)
                        {
                            case StockAdjustmentStatus.Pending: <span class="badge text-bg-warning"><i class="fas fa-hourglass-half"></i> Pending</span> break;
                            case StockAdjustmentStatus.Approved: <span class="badge text-bg-success"><i class="fas fa-check-circle"></i> Approved</span> break;
                            case StockAdjustmentStatus.Rejected: <span class="badge text-bg-danger"><i class="fas fa-circle-xmark"></i> Rejected</span> break;
                            default: <span class="badge text-bg-secondary"><i class="fas fa-ban"></i> Cancelled</span> break;
                        }
                    </td>
                    <td>@a.ReviewedBy</td>
                    @if (canReview)
                    {
                        <td class="text-end text-nowrap actions-cell">
                            @if (a.Status == StockAdjustmentStatus.Pending)
                            {
                                <div class="d-inline-flex gap-1">
                                    <form asp-action="Approve" asp-route-id="@a.Id" method="post" class="confirm-delete" data-confirm-message="Approve @a.AdjustmentNumber? Stock will be changed immediately.">
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button type="submit" class="btn btn-sm btn-success" title="Approve"><i class="fas fa-check"></i> Approve</button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-outline-danger reject-btn" data-id="@a.Id" data-number="@a.AdjustmentNumber" title="Reject"><i class="fas fa-xmark"></i> Reject</button>
                                </div>
                            }
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (canReview)
{
    <div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" id="rejectForm" class="modal-content">
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="rejectModalLabel">Reject <span id="rejectNumber"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-2">Nothing will be changed. The requester will see your reason.</p>
                    <label for="rejectNote" class="form-label required-asterisk">Reason for rejecting</label>
                    <textarea id="rejectNote" name="reviewNote" class="form-control" rows="3" maxlength="500" required></textarea>
                    <div class="invalid-feedback">Please enter a reason.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="fas fa-xmark"></i> Reject</button>
                </div>
            </form>
        </div>
    </div>
}

<style>
    #adjustmentTable tbody tr.clickable-row { cursor: pointer; }
    #adjustmentTable tbody tr.clickable-row:hover { background-color: var(--bs-tertiary-bg); }
</style>

@section Scripts {
    <script>
        (function () {
            var tableEl = document.getElementById('adjustmentTable');
            tableEl.addEventListener('click', function (e) {
                if (e.target.closest('a, button, input, select, form')) return;
                var row = e.target.closest('tr.clickable-row');
                if (row && row.dataset.href) {
                    window.location.href = row.dataset.href;
                }
            });

            // Reject needs a reason, so it goes through one shared dialog whose form is pointed at
            // the clicked row's request. Delegated because DataTables only keeps the current page's
            // rows in the DOM.
            var rejectModalEl = document.getElementById('rejectModal');
            if (rejectModalEl) {
                var rejectModal = new bootstrap.Modal(rejectModalEl);
                var rejectForm = document.getElementById('rejectForm');
                var rejectNote = document.getElementById('rejectNote');
                tableEl.addEventListener('click', function (e) {
                    var btn = e.target.closest('.reject-btn');
                    if (!btn) return;
                    rejectForm.action = '/StockAdjustments/Reject/' + btn.dataset.id;
                    document.getElementById('rejectNumber').textContent = btn.dataset.number;
                    rejectNote.value = '';
                    rejectNote.classList.remove('is-invalid');
                    rejectModal.show();
                });
                rejectModalEl.addEventListener('shown.bs.modal', function () { rejectNote.focus(); });
                rejectForm.addEventListener('submit', function (e) {
                    if (!rejectNote.value.trim()) {
                        e.preventDefault();
                        rejectNote.classList.add('is-invalid');
                    }
                });
                rejectNote.addEventListener('input', function () { rejectNote.classList.remove('is-invalid'); });
            }
        })();
    </script>
}
