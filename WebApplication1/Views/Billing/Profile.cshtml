@model BillingProfileViewModel
@{ ViewData["Title"] = "Billing details"; }

<div class="card" style="max-width: 760px;">
    <form asp-action="Profile" method="post">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-12"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
                <div class="col-12 col-md-6"><label asp-for="ContactName" class="form-label"></label><input asp-for="ContactName" class="form-control" /></div>
                <div class="col-12 col-md-6"><label asp-for="ContactPhone" class="form-label"></label><input asp-for="ContactPhone" class="form-control" inputmode="tel" /></div>
                <div class="col-12 col-md-6"><label asp-for="ContactEmail" class="form-label"></label><input asp-for="ContactEmail" class="form-control" type="email" /><span asp-validation-for="ContactEmail" class="text-danger"></span></div>
                <div class="col-12 col-md-6"><label asp-for="BillingEmail" class="form-label"></label><input asp-for="BillingEmail" class="form-control" type="email" /><span asp-validation-for="BillingEmail" class="text-danger"></span></div>
                <div class="col-12"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /></div>
                <div class="col-12 col-md-6"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /></div>
                <div class="col-12 col-md-6"><label asp-for="TaxId" class="form-label"></label><input asp-for="TaxId" class="form-control" /></div>
            </div>
        </div>
        <div class="card-footer d-flex gap-2">
            <button class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
