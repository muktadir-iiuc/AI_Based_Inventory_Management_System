@using WebApplication1.Models.Saas
@model List<SaasPayment>
@{ ViewData["Title"] = "Payment history"; }

<div class="card">
    <div class="card-body p-0 table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead><tr><th>Date</th><th>Invoice</th><th>Method</th><th>Reference</th><th>Receipt</th><th>Status</th><th class="text-end">Amount</th></tr></thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.ReceivedAt.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")</td>
                    <td><a asp-action="InvoiceDetails" asp-route-id="@p.InvoiceId">@p.Invoice?.InvoiceNumber</a></td>
                    <td>@p.Method</td>
                    <td>@(p.ProviderTransactionId ?? p.Reference)</td>
                    <td>@p.ReceiptNumber</td>
                    <td>@p.Status</td>
                    <td class="text-end">@p.Amount.ToString("0.00") @p.Currency</td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted p-4">No payments yet.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
