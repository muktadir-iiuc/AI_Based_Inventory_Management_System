@model Warehouse
@{
    ViewData["Title"] = "New Warehouse";
    var nextCode = (string)ViewData["NextCode"]!;
}

<form asp-action="Create" method="post" id="warehouseForm">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="alert alert-info py-2 small mb-3"><i class="fas fa-circle-info"></i> The warehouse code is generated automatically once you save.</div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Warehouse Details</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="Name" class="form-label required-asterisk"></label>
                            <input asp-for="Name" class="form-control" id="nameInput" placeholder="e.g. Downtown Branch" autofocus />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-12 mb-0">
                            <label asp-for="Location" class="form-label"></label>
                            <textarea asp-for="Location" class="form-control" rows="3" placeholder="Optional — street address or depot description"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card position-sticky" style="top: 1rem;">
                <div class="card-header">
                    <h3 class="card-title">Preview</h3>
                </div>
                <div class="card-body">
                    <div class="text-muted small mb-1">This warehouse will appear as</div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge text-bg-primary fs-6">@nextCode</span>
                        <span class="fw-semibold" id="namePreview">Warehouse name</span>
                    </div>
                    <hr />
                    <div class="small text-muted">
                        Once saved, you can assign this warehouse to users from the Users page and start receiving stock into it via Purchase Invoices or Stock Transfers.
                    </div>
                </div>
                <div class="card-footer d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Save Warehouse</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            const nameInput = document.getElementById('nameInput');
            const namePreview = document.getElementById('namePreview');

            function updatePreview() {
                namePreview.textContent = nameInput.value.trim() || 'Warehouse name';
            }

            nameInput.addEventListener('input', updatePreview);
            updatePreview();
        })();
    </script>
    <partial name="_ValidationScriptsPartial" />
}
