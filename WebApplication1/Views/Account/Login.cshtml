@model LoginViewModel
@inject WebApplication1.Services.Saas.IPlatformBranding PlatformBranding
@{
    ViewData["Title"] = "Sign In";
    Layout = "_PlatformLoginLayout";   // same sign-in design as the platform console
    var platformName = await PlatformBranding.GetNameAsync();   // always the platform brand, never the tenant's
    var onTenantPage = !string.IsNullOrEmpty(Model.TenantName);
}

<div class="platform-card p-4 p-sm-5">
    <div class="text-center mb-4">
        <img src="/Platform/Logo" alt="" style="height: 56px; width: auto; max-width: 160px;" class="mb-3" />
        <h1 class="h4 mb-1">@platformName</h1>
        <span class="platform-badge">@(onTenantPage ? "Sign in" : "Business sign-in")</span>
    </div>

    @if (TempData["Success"] is string signedUp)
    {
        <div class="alert alert-success py-2">@signedUp</div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger py-2" role="alert">@Model.ErrorMessage @if (Model.ShowPlatformLink) { <a href="/Platform/Login" class="alert-link">Go to platform sign-in</a> }</div>
    }

    <form asp-action="Login" method="post" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />
        <input type="hidden" asp-for="TenantCode" />
        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label small text-uppercase text-secondary">Email</label>
            <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label small text-uppercase text-secondary">Password</label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="form-check mb-0">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label small">Keep me signed in on this device</label>
            </div>
            <a class="link-warning small" href="/Account/ForgotPassword">Forgot password?</a>
        </div>
        <button class="btn btn-platform w-100 py-2"><i class="fas fa-lock me-2"></i>Sign In</button>
    </form>

    @if (Model.ShowOtherBusinessLink)
    {
        <p class="text-center small mt-4 mb-0"><a class="link-warning" href="/Account/Login?other=true">Not @Model.TenantName? Sign in to a different business</a></p>
    }
    else if (!onTenantPage)
    {
        <p class="text-center text-secondary small mt-4 mb-0">New here? <a class="link-warning" href="/Register">Start your free trial</a></p>
    }
</div>
