@inject ICompanySettingsService CompanySettings
@{
    ViewData["Title"] = "Access Denied";
    Layout = "_LoginLayout";
    var company = await CompanySettings.GetAsync();
}

<div class="card px-sm-6 px-0">
    <div class="card-body text-center">
        <div class="app-brand justify-content-center">
            <a href="#" class="app-brand-link gap-2">
                @if (company.LogoImage is not null)
                {
                    <img src="@Url.Action("Logo", "CompanySettings")" alt="@company.CompanyName" class="app-brand-logo demo" style="height:32px;width:auto;" />
                }
                <span class="app-brand-text demo text-heading fw-bold">@company.CompanyName</span>
            </a>
        </div>

        <i class="icon-base bx bx-block text-danger" style="font-size: 3rem;"></i>
        <h4 class="mt-3 mb-1">Access Denied</h4>
        <p class="mb-6">Your account does not have permission to view that page.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary d-grid w-100 mb-3">Back to Dashboard</a>
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-link">Sign in as a different user</button>
        </form>
    </div>
</div>
