@{
    ViewData["Title"] = "Access Denied";
    Layout = "_LoginLayout";
}

<div class="login-logo">
    <a href="#"><b>Inventory</b>MS</a>
</div>
<div class="card">
    <div class="card-body login-card-body text-center">
        <i class="fas fa-ban text-danger" style="font-size: 3rem;"></i>
        <h4 class="mt-3">Access Denied</h4>
        <p class="text-muted">Your account does not have permission to view that page.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Dashboard</a>
        <form asp-controller="Account" asp-action="Logout" method="post" class="mt-2">
            <button type="submit" class="btn btn-link">Sign in as a different user</button>
        </form>
    </div>
</div>
