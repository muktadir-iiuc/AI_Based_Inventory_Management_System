@using WebApplication1.Models.Saas
@model PlanEditViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "New plan" : $"Edit plan: {Model.Name}";
    var subscribers = ViewData["Subscribers"] as int? ?? 0;
}

@if (subscribers > 0)
{
    <div class="alert alert-warning small">@subscribers tenant(s) are on this plan. Edits do not change their current terms.</div>
}

<div class="card" style="max-width: 980px;">
    <form asp-action="Save" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="card-body">
            <div asp-validation-summary="All" class="text-danger"></div>
            <h6>Plan</h6>
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-4"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
                <div class="col-12 col-md-4"><label asp-for="Code" class="form-label">Plan code</label><input asp-for="Code" class="form-control" /></div>
                <div class="col-6 col-md-2"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<PlanStatus>()" class="form-select"></select></div>
                <div class="col-6 col-md-2"><label asp-for="SortOrder" class="form-label"></label><input asp-for="SortOrder" class="form-control" /></div>
                <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" rows="2" class="form-control"></textarea></div>
            </div>

            <h6>Pricing and billing</h6>
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3"><label asp-for="Price" class="form-label"></label><input asp-for="Price" type="number" step="0.01" min="0" class="form-control" /></div>
                <div class="col-6 col-md-2"><label asp-for="Currency" class="form-label"></label><input asp-for="Currency" maxlength="3" class="form-control text-uppercase" /></div>
                <div class="col-6 col-md-2"><label asp-for="IntervalCount" class="form-label"></label><input asp-for="IntervalCount" type="number" min="1" class="form-control" /></div>
                <div class="col-6 col-md-2"><label asp-for="IntervalUnit" class="form-label"></label><select asp-for="IntervalUnit" asp-items="Html.GetEnumSelectList<BillingIntervalUnit>()" class="form-select"></select></div>
                <div class="col-6 col-md-3"><label asp-for="TrialDays" class="form-label"></label><input asp-for="TrialDays" type="number" min="0" class="form-control" /></div>
                <div class="col-6 col-md-3"><label asp-for="GraceDays" class="form-label"></label><input asp-for="GraceDays" type="number" min="0" class="form-control" /></div>
                <div class="col-6 col-md-3"><label asp-for="TaxPercent" class="form-label"></label><input asp-for="TaxPercent" type="number" step="0.01" min="0" max="100" class="form-control" /></div>
                <div class="col-6 col-md-3"><label asp-for="DiscountPercent" class="form-label"></label><input asp-for="DiscountPercent" type="number" step="0.01" min="0" max="100" class="form-control" /></div>
                <div class="col-6 col-md-3 d-flex align-items-end"><div class="form-check"><input asp-for="AutoRenew" class="form-check-input" /><label asp-for="AutoRenew" class="form-check-label"></label></div></div>
                <div class="col-6 col-md-3 d-flex align-items-end"><div class="form-check"><input asp-for="IsPublic" class="form-check-input" /><label asp-for="IsPublic" class="form-check-label"></label></div></div>
                <div class="col-6 col-md-3"><label asp-for="AvailableFrom" class="form-label"></label><input asp-for="AvailableFrom" type="datetime-local" class="form-control" /></div>
                <div class="col-6 col-md-3"><label asp-for="AvailableTo" class="form-label"></label><input asp-for="AvailableTo" type="datetime-local" class="form-control" /></div>
            </div>

            <h6>Limits <small class="text-muted">(blank = unlimited)</small></h6>
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3"><label asp-for="MaxUsers" class="form-label"></label><input asp-for="MaxUsers" type="number" min="0" class="form-control" /></div>
                <div class="col-6 col-md-3"><label asp-for="MaxProducts" class="form-label"></label><input asp-for="MaxProducts" type="number" min="0" class="form-control" /></div>
                <div class="col-6 col-md-3"><label asp-for="MaxWarehouses" class="form-label"></label><input asp-for="MaxWarehouses" type="number" min="0" class="form-control" /></div>
                <div class="col-6 col-md-3"><label asp-for="MaxStorageMb" class="form-label"></label><input asp-for="MaxStorageMb" type="number" min="0" class="form-control" /></div>
            </div>

            <h6>Included modules</h6>
            <div class="row g-2">
                @foreach (var (key, label) in Features.All)
                {
                    <div class="col-12 col-md-6">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="FeatureKeys" value="@key" id="f_@key" checked="@Model.FeatureKeys.Contains(key)" />
                            <label class="form-check-label" for="f_@key">@label</label>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="card-footer d-flex gap-2"><button class="btn btn-primary">Save plan</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>
    </form>
</div>
