@model JournalEntryCreateViewModel
@{
    ViewData["Title"] = "New Journal Entry";
}

<div class="card">
    <div class="card-body">
        <form asp-action="CreateJournalEntry" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="Date" class="form-label required-asterisk"></label>
                    <input asp-for="Date" class="form-control" type="date" />
                </div>
                <div class="col-md-9 mb-3">
                    <label asp-for="Description" class="form-label required-asterisk"></label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>

            <table class="table table-bordered" id="linesTable">
                <thead>
                    <tr>
                        <th style="width: 40%">Account</th>
                        <th style="width: 25%">Memo</th>
                        <th style="width: 15%">Debit</th>
                        <th style="width: 15%">Credit</th>
                        <th style="width: 5%"></th>
                    </tr>
                </thead>
                <tbody id="linesBody"></tbody>
                <tfoot>
                    <tr>
                        <td colspan="2" class="text-end fw-bold">Totals</td>
                        <td class="fw-bold" id="totalDebit">0.00</td>
                        <td class="fw-bold" id="totalCredit">0.00</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>

            <button type="button" class="btn btn-outline-secondary btn-sm mb-3" id="addRow"><i class="fas fa-plus"></i> Add line</button>

            <div>
                <button type="submit" class="btn btn-primary">Post Journal Entry</button>
                <a asp-action="JournalEntries" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const accounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["AccountsFull"]));
        let rowIndex = 0;

        function accountOptions() {
            let html = '<option value="">-- select account --</option>';
            accounts.forEach(a => {
                html += `<option value="${a.Id}">${a.Code} - ${a.Name}</option>`;
            });
            return html;
        }

        function addRow() {
            const tbody = document.getElementById('linesBody');
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td><select name="Lines[${rowIndex}].AccountId" class="form-select">${accountOptions()}</select></td>
                <td><input name="Lines[${rowIndex}].Memo" class="form-control" /></td>
                <td><input name="Lines[${rowIndex}].Debit" type="number" step="0.01" min="0" class="form-control debit-input" value="0" /></td>
                <td><input name="Lines[${rowIndex}].Credit" type="number" step="0.01" min="0" class="form-control credit-input" value="0" /></td>
                <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger remove-row"><i class="fas fa-times"></i></button></td>
            `;
            tbody.appendChild(tr);
            rowIndex++;

            tr.querySelector('.debit-input').addEventListener('input', recalc);
            tr.querySelector('.credit-input').addEventListener('input', recalc);
            tr.querySelector('.remove-row').addEventListener('click', () => { tr.remove(); recalc(); });

            initSelect2(tr);
        }

        function recalc() {
            let debit = 0, credit = 0;
            document.querySelectorAll('#linesBody tr').forEach(tr => {
                debit += parseFloat(tr.querySelector('.debit-input').value) || 0;
                credit += parseFloat(tr.querySelector('.credit-input').value) || 0;
            });
            document.getElementById('totalDebit').textContent = debit.toFixed(2);
            document.getElementById('totalCredit').textContent = credit.toFixed(2);
        }

        document.getElementById('addRow').addEventListener('click', addRow);
        addRow();
        addRow();
    </script>
    <partial name="_ValidationScriptsPartial" />
}
