@model List<Payment>
@{
    ViewData["Title"] = "Payments & Receipts";
    var totalIn = Model.Where(p => p.Direction == PaymentDirection.In).Sum(p => p.Amount);
    var totalOut = Model.Where(p => p.Direction == PaymentDirection.Out).Sum(p => p.Amount);
}

@section Toolbar {
    @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager) || User.IsInRole(Roles.Accountant))
    {
        <a asp-action="CreatePayment" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> New Payment / Receipt</a>
    }
}

<div class="row g-3 mb-3">
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body py-3">
                <div class="text-muted small">Entries Listed</div>
                <div class="fs-4 fw-bold">@Model.Count</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body py-3">
                <div class="text-muted small">Received from Customers</div>
                <div class="fs-4 fw-bold text-success">@totalIn.ToString("C")</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body py-3">
                <div class="text-muted small">Paid to Suppliers</div>
                <div class="fs-4 fw-bold text-danger">@totalOut.ToString("C")</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0 table-responsive-card">
        <table class="table table-striped table-hover mb-0 data-table">
            <thead><tr><th>Payment #</th><th data-filter="date">Date</th><th data-filter="select">Direction</th><th>Against</th><th>Notes</th><th class="text-end">Amount</th></tr></thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td class="fw-semibold">@p.PaymentNumber</td>
                    <td data-date="@p.Date.ToString("yyyy-MM-dd")">@p.Date.ToString("MMM dd, yyyy")</td>
                    <td>
                        @if (p.Direction == PaymentDirection.Out) { <span class="badge text-bg-danger">Paid to supplier</span> }
                        else { <span class="badge text-bg-success">Received from customer</span> }
                    </td>
                    <td>
                        @if (p.PurchaseInvoice is not null)
                        {
                            <a asp-controller="PurchaseInvoices" asp-action="Details" asp-route-id="@p.PurchaseInvoiceId">@p.PurchaseInvoice.InvoiceNumber</a>
                            <span class="text-muted">(@p.PurchaseInvoice.Supplier?.Name)</span>
                        }
                        @if (p.SalesInvoice is not null)
                        {
                            <a asp-controller="SalesInvoices" asp-action="Details" asp-route-id="@p.SalesInvoiceId">@p.SalesInvoice.InvoiceNumber</a>
                            <span class="text-muted">(@p.SalesInvoice.Customer?.Name)</span>
                        }
                        @if (p.Customer is not null)
                        {
                            <a asp-controller="Customers" asp-action="Ledger" asp-route-partyId="@p.CustomerId">Opening balance</a>
                            <span class="text-muted">(@p.Customer.Name)</span>
                        }
                        @if (p.Supplier is not null)
                        {
                            <a asp-controller="Suppliers" asp-action="Ledger" asp-route-partyId="@p.SupplierId">Opening balance</a>
                            <span class="text-muted">(@p.Supplier.Name)</span>
                        }
                    </td>
                    <td>@p.Notes</td>
                    <td class="text-end fw-semibold">@p.Amount.ToString("C")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
