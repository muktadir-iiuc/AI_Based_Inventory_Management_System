@model List<Account>
@{
    ViewData["Title"] = "Chart of Accounts";
}

@section Toolbar {
    @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager) || User.IsInRole(Roles.Accountant))
    {
        <a asp-action="CreateAccount" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> New Account</a>
    }
}

<div class="card">
    <div class="card-body p-0 table-responsive-card">
        <table class="table table-striped table-hover mb-0 data-table" id="accountTable">
            <thead><tr><th>Code</th><th>Name</th><th data-filter="select">Type</th><th data-filter="select">Status</th><th data-filter="false"></th></tr></thead>
            <tbody>
            @foreach (var a in Model)
            {
                <tr class="clickable-row" data-href="@Url.Action("Ledger", new { accountId = a.Id })">
                    <td>@a.Code</td>
                    <td><a asp-action="Ledger" asp-route-accountId="@a.Id" class="fw-semibold">@a.Name</a></td>
                    <td>@a.Type</td>
                    <td>
                        @if (a.IsActive) { <span class="badge text-bg-success">Active</span> }
                        else { <span class="badge text-bg-secondary">Inactive</span> }
                    </td>
                    <td class="text-end">
                        @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager) || User.IsInRole(Roles.Accountant))
                        {
                            <div class="table-actions">
                                <a asp-action="EditAccount" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary" title="Edit account"><i class="fas fa-pen"></i></a>
                            </div>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<style>
    #accountTable tbody tr.clickable-row { cursor: pointer; }
    #accountTable tbody tr.clickable-row:hover { background-color: var(--bs-tertiary-bg); }
</style>

@section Scripts {
    <script>
        document.getElementById('accountTable').addEventListener('click', function (e) {
            if (e.target.closest('a, button, input, form')) return;
            var row = e.target.closest('tr.clickable-row');
            if (row && row.dataset.href) {
                window.location.href = row.dataset.href;
            }
        });
    </script>
}
