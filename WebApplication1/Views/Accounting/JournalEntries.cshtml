@model List<JournalEntry>
@{
    ViewData["Title"] = "Journal Entries";
    var totalDebit = Model.Sum(j => j.TotalDebit);
}

@section Toolbar {
    @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager) || User.IsInRole(Roles.Accountant))
    {
        <a asp-action="CreateJournalEntry" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> New Journal Entry</a>
    }
}

<div class="row g-3 mb-3">
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body py-3">
                <div class="text-muted small">Entries Listed</div>
                <div class="fs-4 fw-bold">@Model.Count</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body py-3">
                <div class="text-muted small">Total Debit / Credit</div>
                <div class="fs-4 fw-bold">@totalDebit.ToString("C")</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0 table-responsive-card">
        <table class="table table-striped table-hover mb-0 data-table" id="journalTable">
            <thead><tr><th>Entry #</th><th data-filter="date">Date</th><th>Description</th><th data-filter="select">Source</th><th class="text-end">Amount</th></tr></thead>
            <tbody>
            @foreach (var j in Model)
            {
                <tr class="clickable-row" data-href="@Url.Action("JournalEntryDetails", new { id = j.Id })">
                    <td><a asp-action="JournalEntryDetails" asp-route-id="@j.Id" class="fw-semibold">@j.EntryNumber</a></td>
                    <td data-date="@j.Date.ToString("yyyy-MM-dd")">@j.Date.ToString("MMM dd, yyyy")</td>
                    <td>@j.Description</td>
                    <td><span class="badge text-bg-light border">@j.Source</span></td>
                    <td class="text-end fw-semibold">@j.TotalDebit.ToString("C")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<style>
    #journalTable tbody tr.clickable-row { cursor: pointer; }
    #journalTable tbody tr.clickable-row:hover { background-color: var(--bs-tertiary-bg); }
</style>

@section Scripts {
    <script>
        document.getElementById('journalTable').addEventListener('click', function (e) {
            if (e.target.closest('a, button, input')) return;
            var row = e.target.closest('tr.clickable-row');
            if (row && row.dataset.href) {
                window.location.href = row.dataset.href;
            }
        });
    </script>
}
