@model PaymentCreateViewModel
@{
    ViewData["Title"] = "New Payment / Receipt";
    var purchaseList = (SelectList)ViewData["PurchaseInvoices"]!;
    var salesList = (SelectList)ViewData["SalesInvoices"]!;
    var openingCustomers = (SelectList)ViewData["OpeningCustomers"]!;
    var openingSuppliers = (SelectList)ViewData["OpeningSuppliers"]!;
    var isOut = Model.Direction == PaymentDirection.Out;
}

<form asp-action="CreatePayment" method="post" id="paymentForm">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Payment Details</h3>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label required-asterisk">Direction</label>
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="Direction" id="dirIn" value="@((int)PaymentDirection.In)" checked="@(!isOut)">
                            <label class="btn btn-outline-success" for="dirIn"><i class="fas fa-arrow-down"></i> Receive from Customer</label>

                            <input type="radio" class="btn-check" name="Direction" id="dirOut" value="@((int)PaymentDirection.Out)" checked="@isOut">
                            <label class="btn btn-outline-danger" for="dirOut"><i class="fas fa-arrow-up"></i> Pay to Supplier</label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label required-asterisk">Against</label>
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="AgainstOpeningBalance" id="againstInvoice" value="false" checked="@(!Model.AgainstOpeningBalance)">
                            <label class="btn btn-outline-secondary" for="againstInvoice"><i class="fas fa-file-invoice"></i> Invoice</label>

                            <input type="radio" class="btn-check" name="AgainstOpeningBalance" id="againstOpening" value="true" checked="@Model.AgainstOpeningBalance">
                            <label class="btn btn-outline-secondary" for="againstOpening"><i class="fas fa-scale-balanced"></i> Opening Balance</label>
                        </div>
                    </div>

                    <div class="mb-3" id="salesInvoiceGroup">
                        <label asp-for="SalesInvoiceId" class="form-label">Sales Invoice</label>
                        <select asp-for="SalesInvoiceId" asp-items="salesList" class="form-select" id="salesInvoiceSelect">
                            <option value="">-- select sales invoice --</option>
                        </select>
                        <div class="alert alert-info py-2 small mt-2 mb-0 d-none" id="salesInvoiceInfo">
                            <dl class="row mb-0">
                                <dt class="col-7 fw-normal">Invoice Amount</dt>
                                <dd class="col-5 text-end" id="salesInvoiceAmount">0.00</dd>
                                <dt class="col-7 fw-normal">This Invoice's Due</dt>
                                <dd class="col-5 text-end" id="salesInvoiceDue">0.00</dd>
                                <dt class="col-7 fw-normal">Customer Total Outstanding</dt>
                                <dd class="col-5 text-end fw-bold" id="customerOutstanding">0.00</dd>
                            </dl>
                        </div>
                    </div>

                    <div class="mb-3 d-none" id="purchaseInvoiceGroup">
                        <label asp-for="PurchaseInvoiceId" class="form-label">Purchase Invoice</label>
                        <select asp-for="PurchaseInvoiceId" asp-items="purchaseList" class="form-select" id="purchaseInvoiceSelect">
                            <option value="">-- select purchase invoice --</option>
                        </select>
                        <div class="alert alert-info py-2 small mt-2 mb-0 d-none" id="purchaseInvoiceInfo">
                            <dl class="row mb-0">
                                <dt class="col-7 fw-normal">Invoice Amount</dt>
                                <dd class="col-5 text-end" id="purchaseInvoiceAmount">0.00</dd>
                                <dt class="col-7 fw-normal">This Invoice's Due</dt>
                                <dd class="col-5 text-end" id="purchaseInvoiceDue">0.00</dd>
                                <dt class="col-7 fw-normal">Supplier Total Outstanding</dt>
                                <dd class="col-5 text-end fw-bold" id="supplierOutstanding">0.00</dd>
                            </dl>
                        </div>
                    </div>

                    <div class="mb-3 d-none" id="customerOpeningGroup">
                        <label asp-for="CustomerId" class="form-label">Customer</label>
                        <select asp-for="CustomerId" asp-items="openingCustomers" class="form-select" id="customerOpeningSelect">
                            <option value="">-- select customer with an opening balance due --</option>
                        </select>
                        <div class="alert alert-info py-2 small mt-2 mb-0 d-none" id="customerOpeningInfo">
                            <dl class="row mb-0">
                                <dt class="col-7 fw-normal">Opening Balance</dt>
                                <dd class="col-5 text-end" id="customerOpeningAmount">0.00</dd>
                                <dt class="col-7 fw-normal">Opening Balance Still Due</dt>
                                <dd class="col-5 text-end" id="customerOpeningDue">0.00</dd>
                                <dt class="col-7 fw-normal">Customer Total Outstanding</dt>
                                <dd class="col-5 text-end fw-bold" id="customerOpeningOutstanding">0.00</dd>
                            </dl>
                        </div>
                    </div>

                    <div class="mb-3 d-none" id="supplierOpeningGroup">
                        <label asp-for="SupplierId" class="form-label">Supplier</label>
                        <select asp-for="SupplierId" asp-items="openingSuppliers" class="form-select" id="supplierOpeningSelect">
                            <option value="">-- select supplier with an opening balance due --</option>
                        </select>
                        <div class="alert alert-info py-2 small mt-2 mb-0 d-none" id="supplierOpeningInfo">
                            <dl class="row mb-0">
                                <dt class="col-7 fw-normal">Opening Balance</dt>
                                <dd class="col-5 text-end" id="supplierOpeningAmount">0.00</dd>
                                <dt class="col-7 fw-normal">Opening Balance Still Due</dt>
                                <dd class="col-5 text-end" id="supplierOpeningDue">0.00</dd>
                                <dt class="col-7 fw-normal">Supplier Total Outstanding</dt>
                                <dd class="col-5 text-end fw-bold" id="supplierOpeningOutstanding">0.00</dd>
                            </dl>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Date" class="form-label required-asterisk"></label>
                            <input asp-for="Date" class="form-control" type="date" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Amount" class="form-label required-asterisk"></label>
                            <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" id="amountInput" />
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                            <div class="text-danger small d-none" id="amountExceedsWarning"></div>
                            <div class="form-text" id="amountHint">Pre-filled with the selected invoice's due amount — adjust for a partial payment, but it can't exceed what's still due.</div>
                        </div>
                    </div>
                    <div class="mb-0">
                        <label asp-for="Notes" class="form-label"></label>
                        <input asp-for="Notes" class="form-control" placeholder="Optional note for this payment" />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card position-sticky" style="top: 1rem;">
                <div class="card-header">
                    <h3 class="card-title">Summary</h3>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge fs-6" id="directionBadge">Receive from Customer</span>
                    </div>
                    <dl class="row mb-0">
                        <dt class="col-6 text-muted fw-normal">Against</dt>
                        <dd class="col-6 text-end" id="summaryInvoice">&mdash;</dd>
                        <dt class="col-6 text-muted fw-normal">Party</dt>
                        <dd class="col-6 text-end" id="summaryParty">&mdash;</dd>
                    </dl>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Amount</span>
                        <span class="fs-3 fw-bold text-primary" id="summaryAmount">0.00</span>
                    </div>
                </div>
                <div class="card-footer d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Save Payment</button>
                    <a asp-action="Payments" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        const dirIn = document.getElementById('dirIn');
        const dirOut = document.getElementById('dirOut');
        const againstInvoice = document.getElementById('againstInvoice');
        const againstOpening = document.getElementById('againstOpening');
        const directionBadge = document.getElementById('directionBadge');
        const amountInput = document.getElementById('amountInput');
        const amountHint = document.getElementById('amountHint');
        const summaryInvoice = document.getElementById('summaryInvoice');
        const summaryParty = document.getElementById('summaryParty');
        const summaryAmount = document.getElementById('summaryAmount');
        const amountWarning = document.getElementById('amountExceedsWarning');
        const submitButton = document.querySelector('#paymentForm button[type="submit"]');
        let amountManuallyEdited = false;

        // One entry per (direction, against) combination: which group/select is active, where
        // its meta rows come from, and how to read "what's still due" off a meta row.
        const sources = {
            inInvoice: {
                group: 'salesInvoiceGroup', select: 'salesInvoiceSelect', info: 'salesInvoiceInfo',
                meta: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["SalesInvoiceMeta"])),
                fields: { salesInvoiceAmount: r => r.InvoiceAmount, salesInvoiceDue: r => r.InvoiceDue, customerOutstanding: r => r.CustomerOutstanding },
                due: r => r.InvoiceDue, party: r => r.CustomerName, label: sel => sel.text.split(' - ')[0],
                dueName: "this invoice's due"
            },
            outInvoice: {
                group: 'purchaseInvoiceGroup', select: 'purchaseInvoiceSelect', info: 'purchaseInvoiceInfo',
                meta: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["PurchaseInvoiceMeta"])),
                fields: { purchaseInvoiceAmount: r => r.InvoiceAmount, purchaseInvoiceDue: r => r.InvoiceDue, supplierOutstanding: r => r.SupplierOutstanding },
                due: r => r.InvoiceDue, party: r => r.SupplierName, label: sel => sel.text.split(' - ')[0],
                dueName: "this invoice's due"
            },
            inOpening: {
                group: 'customerOpeningGroup', select: 'customerOpeningSelect', info: 'customerOpeningInfo',
                meta: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["CustomerOpeningMeta"])),
                fields: { customerOpeningAmount: r => r.OpeningBalance, customerOpeningDue: r => r.OpeningDue, customerOpeningOutstanding: r => r.CustomerOutstanding },
                due: r => r.OpeningDue, party: r => r.CustomerName, label: () => 'Opening balance',
                dueName: 'the remaining opening balance'
            },
            outOpening: {
                group: 'supplierOpeningGroup', select: 'supplierOpeningSelect', info: 'supplierOpeningInfo',
                meta: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["SupplierOpeningMeta"])),
                fields: { supplierOpeningAmount: r => r.OpeningBalance, supplierOpeningDue: r => r.OpeningDue, supplierOpeningOutstanding: r => r.SupplierOutstanding },
                due: r => r.OpeningDue, party: r => r.SupplierName, label: () => 'Opening balance',
                dueName: 'the remaining opening balance'
            }
        };

        function money(n) {
            return Number(n || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function activeKey() {
            return (dirIn.checked ? 'in' : 'out') + (againstOpening.checked ? 'Opening' : 'Invoice');
        }

        function currentRow() {
            const src = sources[activeKey()];
            const id = parseInt(document.getElementById(src.select).value, 10);
            return src.meta.find(m => m.Id === id);
        }

        // Re-checked against the same due figure shown in the info panel — the server always
        // re-validates against a fresh read too, since due can change between page load and submit.
        function validateAmount() {
            const src = sources[activeKey()];
            const row = currentRow();
            const amount = parseFloat(amountInput.value) || 0;
            const exceeds = !!row && amount > src.due(row);

            amountInput.classList.toggle('is-invalid', exceeds);
            amountWarning.classList.toggle('d-none', !exceeds);
            if (exceeds) {
                amountWarning.textContent = `Amount cannot exceed ${src.dueName} of ${money(src.due(row))}.`;
            }
            if (submitButton) {
                submitButton.disabled = exceeds;
            }
            return !exceeds;
        }

        function updateSummary() {
            const src = sources[activeKey()];
            const row = currentRow();
            const option = document.getElementById(src.select).selectedOptions[0];
            summaryInvoice.textContent = row && option ? src.label(option) : '—';
            summaryParty.textContent = row ? src.party(row) : '—';
            summaryAmount.textContent = money(amountInput.value);
            validateAmount();
        }

        function updateInfo(src) {
            const info = document.getElementById(src.info);
            const row = src.meta.find(m => m.Id === parseInt(document.getElementById(src.select).value, 10));
            if (!row) {
                info.classList.add('d-none');
            } else {
                Object.entries(src.fields).forEach(([id, get]) => document.getElementById(id).textContent = money(get(row)));
                info.classList.remove('d-none');
                if (!amountManuallyEdited) {
                    amountInput.value = src.due(row).toFixed(2);
                }
            }
            updateSummary();
        }

        // resetValues is false only on first load, so a form redisplayed after a server-side
        // validation error keeps the user's direction, selection and amount.
        function toggle(resetValues) {
            const key = activeKey();
            Object.entries(sources).forEach(([k, src]) => {
                document.getElementById(src.group).classList.toggle('d-none', k !== key);
                if (resetValues || k !== key) {
                    // Only the visible select may submit a value — the server reads the one
                    // matching Direction/AgainstOpeningBalance, but stale ones would confuse it.
                    document.getElementById(src.select).value = '';
                    document.getElementById(src.info).classList.add('d-none');
                }
            });

            directionBadge.textContent = dirIn.checked ? 'Receive from Customer' : 'Pay to Supplier';
            directionBadge.className = 'badge fs-6 ' + (dirIn.checked ? 'text-bg-success' : 'text-bg-danger');
            amountHint.textContent = againstOpening.checked
                ? "Pre-filled with what's left of the opening balance — adjust for a partial payment, but it can't exceed what's still due."
                : "Pre-filled with the selected invoice's due amount — adjust for a partial payment, but it can't exceed what's still due.";

            if (resetValues) {
                amountInput.value = '';
                amountManuallyEdited = false;
            }
            amountInput.classList.remove('is-invalid');
            amountWarning.classList.add('d-none');

            // Select2 computes its width from the element's visible container, so a widget
            // initialized while hidden behind d-none ends up 0px wide; rebuild it once shown.
            document.querySelectorAll('.select2-hidden-accessible').forEach(el => {
                jQuery(el).select2('destroy');
            });
            initSelect2(document);
            if (!resetValues) {
                updateInfo(sources[key]);
            }
            updateSummary();
        }
        [dirIn, dirOut, againstInvoice, againstOpening].forEach(el => el.addEventListener('change', () => toggle(true)));

        amountInput.addEventListener('input', () => {
            amountManuallyEdited = true;
            updateSummary();
        });

        Object.values(sources).forEach(src => {
            const select = document.getElementById(src.select);
            const onPick = () => { amountManuallyEdited = false; updateInfo(src); };
            select.addEventListener('change', onPick);
            if (typeof jQuery !== 'undefined') {
                // Bound on the <select> itself (where Select2 triggers these), so it survives
                // toggle() destroying and recreating the Select2 widget.
                jQuery(select).on('select2:select select2:clear', onPick);
            }
        });

        // A fresh page renders the model's default 0 — show it blank, as before. A redisplayed
        // form keeps the user's amount rather than overwriting it with the due.
        if (!(parseFloat(amountInput.value) > 0)) {
            amountInput.value = '';
        }
        amountManuallyEdited = amountInput.value !== '';
        toggle(false);
    </script>
    <partial name="_ValidationScriptsPartial" />
}
