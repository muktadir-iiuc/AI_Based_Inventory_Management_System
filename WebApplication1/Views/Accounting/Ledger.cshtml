@model LedgerViewModel
@{
    ViewData["Title"] = $"Ledger: {Model.Account.Name}";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">@Model.Account.Code &mdash; @Model.Account.Name</h3>
    </div>
    <div class="card-body p-0 table-responsive-card">
        <table class="table table-striped table-hover mb-0 data-table">
            <thead><tr><th data-filter="date">Date</th><th>Entry #</th><th>Memo</th><th class="text-end">Debit</th><th class="text-end">Credit</th><th class="text-end">Balance</th></tr></thead>
            <tbody>
            @foreach (var line in Model.Rows)
            {
                <tr>
                    <td data-date="@line.Date?.ToString("yyyy-MM-dd")">@line.Date?.ToString("MMM dd, yyyy")</td>
                    <td><a asp-action="JournalEntryDetails" asp-route-id="@line.JournalEntryId" class="fw-semibold">@line.EntryNumber</a></td>
                    <td>@line.Memo</td>
                    <td class="text-end">@(line.Debit > 0 ? line.Debit.ToString("C") : "")</td>
                    <td class="text-end">@(line.Credit > 0 ? line.Credit.ToString("C") : "")</td>
                    <td class="text-end">@line.RunningBalance.ToString("C")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="card-footer">
        <a asp-action="ChartOfAccounts" class="btn btn-secondary btn-sm">Back to chart of accounts</a>
    </div>
</div>
