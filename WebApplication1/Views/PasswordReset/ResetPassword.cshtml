@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "_PlatformLoginLayout";
}

<div class="platform-card p-4 p-sm-5">
    <partial name="~/Views/PasswordReset/_Header.cshtml" />
    <p class="text-secondary small">Choose a new password for <strong class="text-light">@Model.Email</strong>.</p>

    <form asp-action="ResetPassword" method="post" novalidate>
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 small" role="alert">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).Distinct())
                {
                    <div>@error</div>
                }
            </div>
        }
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label small text-uppercase text-secondary"></label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus />
            <div class="form-text">At least 8 characters, with an uppercase letter, a lowercase letter, a digit, and a symbol.</div>
        </div>
        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label small text-uppercase text-secondary"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        </div>
        <button class="btn btn-platform w-100 py-2"><i class="fas fa-key me-2"></i>Reset password</button>
    </form>
</div>
