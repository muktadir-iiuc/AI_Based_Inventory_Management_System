@{
    ViewData["Title"] = "Check your email";
    Layout = "_PlatformLoginLayout";
}

<div class="platform-card p-4 p-sm-5">
    <partial name="~/Views/PasswordReset/_Header.cshtml" />
    <h2 class="h5 mb-2">Check your email</h2>
    <p class="text-secondary small">If an account exists for that email, a password reset link has been sent. The link expires in 1 hour.</p>
    <a class="btn btn-platform w-100 py-2" href="@ViewData["BackUrl"]">Back to sign in</a>
</div>
