@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_PlatformLoginLayout";
}

<div class="platform-card p-4 p-sm-5">
    <partial name="~/Views/PasswordReset/_Header.cshtml" />
    <p class="text-secondary small">Enter your registered account email and we will send you a link to reset your password.</p>

    <form asp-action="ForgotPassword" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
        <div class="mb-4">
            <label asp-for="Email" class="form-label small text-uppercase text-secondary">Email</label>
            <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <button class="btn btn-platform w-100 py-2"><i class="fas fa-envelope me-2"></i>Send reset link</button>
    </form>

    <p class="text-center small mt-4 mb-0"><a class="link-warning" href="@ViewData["BackUrl"]">Back to sign in</a></p>
</div>
