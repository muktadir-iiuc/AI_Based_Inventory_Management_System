@{
    ViewData["Title"] = "Password updated";
    Layout = "_PlatformLoginLayout";
}

<div class="platform-card p-4 p-sm-5">
    <partial name="~/Views/PasswordReset/_Header.cshtml" />
    <h2 class="h5 mb-2">Password updated</h2>
    <p class="text-secondary small">Your password has been reset. You can now sign in with the new password.</p>
    <a class="btn btn-platform w-100 py-2" href="@ViewData["BackUrl"]">Sign in</a>
</div>
