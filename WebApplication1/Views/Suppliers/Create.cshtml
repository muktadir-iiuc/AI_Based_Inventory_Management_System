@model Supplier
@{
    ViewData["Title"] = "New Supplier";
}

<form asp-action="Create" method="post" id="supplierForm">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Supplier Details</h3>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label required-asterisk"></label>
                        <input asp-for="Name" class="form-control" id="nameInput" placeholder="e.g. Karim Distributors" autofocus />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ContactPerson" class="form-label"></label>
                        <input asp-for="ContactPerson" class="form-control" id="contactInput" placeholder="Person to reach for this account" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" id="phoneInput" placeholder="e.g. 01XXXXXXXXX" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" id="emailInput" placeholder="name@example.com" />
                        </div>
                    </div>
                    <div class="mb-0">
                        <label asp-for="Address" class="form-label"></label>
                        <textarea asp-for="Address" class="form-control" rows="3" placeholder="Optional — shown on purchase invoices and payment records"></textarea>
                    </div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h3 class="card-title">Opening Balance</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="OpeningBalance" class="form-label">Amount</label>
                            <input asp-for="OpeningBalance" class="form-control" type="number" step="0.01" min="0" id="openingAmountInput" />
                            <span asp-validation-for="OpeningBalance" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="OpeningBalanceIsAdvance" class="form-label">Type</label>
                            <select asp-for="OpeningBalanceIsAdvance" class="form-select" id="openingTypeSelect">
                                <option value="False">Due — we owe the supplier</option>
                                <option value="True">Advance — we paid the supplier in advance</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="OpeningBalanceDate" class="form-label">As of Date</label>
                            <input asp-for="OpeningBalanceDate" class="form-control" type="date" value="@((Model.OpeningBalanceDate ?? DateTime.Today).ToString("yyyy-MM-dd"))" />
                            <span asp-validation-for="OpeningBalanceDate" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="form-text mb-0">Optional. Any balance with this supplier from before they were added here — it becomes the first line of their Supplier Ledger and counts toward what we owe them. Leave 0 if there's none.</div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card position-sticky" style="top: 1rem;">
                <div class="card-header">
                    <h3 class="card-title">Preview</h3>
                </div>
                <div class="card-body">
                    <div class="text-muted small mb-1">This supplier will appear as</div>
                    <div class="fw-semibold fs-5" id="namePreview">Supplier name</div>
                    <div class="text-muted small" id="contactPreview"></div>
                    <div class="small mt-2 d-none" id="openingPreview"></div>
                    <hr />
                    <div class="small text-muted">
                        Once saved, you can raise purchase invoices against this supplier and record payments to them.
                    </div>
                </div>
                <div class="card-footer d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Save Supplier</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            const nameInput = document.getElementById('nameInput');
            const contactInput = document.getElementById('contactInput');
            const phoneInput = document.getElementById('phoneInput');
            const emailInput = document.getElementById('emailInput');
            const namePreview = document.getElementById('namePreview');
            const contactPreview = document.getElementById('contactPreview');

            const openingAmountInput = document.getElementById('openingAmountInput');
            const openingTypeSelect = document.getElementById('openingTypeSelect');
            const openingPreview = document.getElementById('openingPreview');

            function updatePreview() {
                namePreview.textContent = nameInput.value.trim() || 'Supplier name';
                const parts = [contactInput.value.trim(), phoneInput.value.trim(), emailInput.value.trim()].filter(Boolean);
                contactPreview.textContent = parts.join(' · ');

                const amount = parseFloat(openingAmountInput.value) || 0;
                const isAdvance = openingTypeSelect.value === 'True';
                openingPreview.className = 'small mt-2 fw-semibold ' + (amount <= 0 ? 'd-none' : isAdvance ? 'text-success' : 'text-danger');
                openingPreview.textContent = `Opening ${isAdvance ? 'advance' : 'due'}: ${amount.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            }

            [nameInput, contactInput, phoneInput, emailInput, openingAmountInput].forEach(el => el.addEventListener('input', updatePreview));
            openingTypeSelect.addEventListener('change', updatePreview);
            if (typeof jQuery !== 'undefined') {
                jQuery(openingTypeSelect).on('select2:select', updatePreview);
            }
            updatePreview();
        })();
    </script>
    <partial name="_ValidationScriptsPartial" />
}
