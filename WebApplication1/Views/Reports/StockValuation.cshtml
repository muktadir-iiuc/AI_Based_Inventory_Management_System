@model StockValuationViewModel
@{
    ViewData["Title"] = "Stock Valuation";
    var totalCostValue = Model.TotalCostValue;
    var totalSaleValue = Model.TotalSaleValue;
}

@if (Model.WarehouseScoped)
{
    <div class="alert alert-info py-2">
        <i class="fas fa-warehouse me-1"></i>
        Showing stock valuation for your assigned warehouse only.
    </div>
}

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label small text-muted mb-1">Warehouse</label>
                <select name="warehouseId" asp-items="Model.Warehouses" class="form-select form-select-sm" style="min-width: 220px;">
                    <option value="">@(Model.WarehouseScoped ? "All my warehouses" : "All warehouses")</option>
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-primary" type="submit"><i class="fas fa-filter"></i> Filter</button>
                @if (Model.WarehouseId.HasValue)
                {
                    <a asp-action="StockValuation" class="btn btn-sm btn-outline-secondary ms-1"><i class="fas fa-xmark"></i> Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <span class="text-muted">Total Inventory Value (at cost)</span>
                <h4>@totalCostValue.ToString("C")</h4>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <span class="text-muted">Total Inventory Value (at sale price)</span>
                <h4>@totalSaleValue.ToString("C")</h4>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0 table-responsive-card">
        <table class="table table-striped table-hover mb-0 data-table">
            <thead>
                <tr>
                    <th>SKU</th><th>Product</th><th data-filter="select">Category</th>
                    <th class="text-end">Stock</th><th class="text-end">Cost</th>
                    <th class="text-end">Value at Cost</th><th class="text-end">Value at Sale Price</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td>@r.Sku</td>
                    <td>@r.ProductName</td>
                    <td>@r.CategoryName</td>
                    <td class="text-end">@r.Stock.ToString("0.##")</td>
                    <td class="text-end">@r.CostPrice.ToString("C")</td>
                    <td class="text-end">@r.ValueAtCost.ToString("C")</td>
                    <td class="text-end">@r.ValueAtSalePrice.ToString("C")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
