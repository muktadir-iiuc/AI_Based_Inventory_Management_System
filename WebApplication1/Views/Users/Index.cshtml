@model List<UserListItem>
@{
    ViewData["Title"] = "Users & Roles";
}

@section Toolbar {
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> New User</a>
}

<div class="card">
    <div class="card-body p-0 table-responsive-card">
        <table class="table table-striped table-hover mb-0 data-table">
            <thead><tr><th>Full Name</th><th>Email</th><th>Role</th><th>Warehouse</th><th data-filter="select">Status</th><th data-filter="false"></th></tr></thead>
            <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.FullName</td>
                    <td>@u.Email</td>
                    <td>
                        @foreach (var r in u.Roles)
                        {
                            <span class="badge text-bg-info">@r</span>
                        }
                    </td>
                    <td>@(u.WarehouseNames.Count > 0 ? string.Join(", ", u.WarehouseNames) : "All warehouses")</td>
                    <td>
                        @if (u.IsActive) { <span class="badge text-bg-success">Active</span> }
                        else { <span class="badge text-bg-secondary">Inactive</span> }
                    </td>
                    <td class="text-end">
                        <div class="table-actions">
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary" title="Edit user"><i class="fas fa-pen"></i></a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
