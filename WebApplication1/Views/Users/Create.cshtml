@model UserCreateViewModel
@{
    ViewData["Title"] = "New User";
    var roleList = (SelectList)ViewData["Roles"]!;
    var warehouseList = (SelectList)ViewData["Warehouses"]!;
    var unrestrictedRoles = (string[])ViewData["UnrestrictedRoles"]!;
}

<div class="card col-md-6">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="FullName" class="form-label required-asterisk"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label required-asterisk"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label required-asterisk"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger small"></span>
                <div class="form-text">At least 8 characters, with upper, lower, digit and symbol.</div>
            </div>
            <div class="mb-3">
                <label asp-for="Roles" class="form-label required-asterisk">Roles</label>
                <select asp-for="Roles" asp-items="roleList" id="roleSelect" class="form-select" multiple></select>
                <div class="form-text">A user can hold more than one role at once (e.g. Sales Officer and Accountant together).</div>
            </div>
            <div class="mb-3" id="warehouseGroup">
                <label asp-for="WarehouseIds" class="form-label required-asterisk">Warehouses</label>
                <select asp-for="WarehouseIds" asp-items="warehouseList" class="form-select" multiple></select>
                <span asp-validation-for="WarehouseIds" class="text-danger small"></span>
                <div class="form-text">Hold Ctrl (Cmd on Mac) to select multiple. This user's activity (invoices, stock) will be limited to the selected warehouse(s).</div>
            </div>
            <partial name="_MenuAccess" model="Model.PermissionKeys" />
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const unrestrictedRoles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(unrestrictedRoles));
        const roleSelect = document.getElementById('roleSelect');
        const warehouseGroup = document.getElementById('warehouseGroup');
        const permissionGroup = document.getElementById('permissionGroup');

        function toggleWarehouse() {
            const selected = Array.from(roleSelect.selectedOptions).map(o => o.value);
            const unrestricted = selected.some(r => unrestrictedRoles.includes(r));
            warehouseGroup.classList.toggle('d-none', unrestricted);
            permissionGroup.classList.toggle('d-none', unrestricted);
        }
        roleSelect.addEventListener('change', toggleWarehouse);
        toggleWarehouse();

        // Picking a role ticks that role's default pages (Purchase Officer -> Purchase Invoices,
        // Sales Officer -> Sales Invoices). Only newly picked roles tick anything, and nothing is
        // ever unticked, so a choice the admin already made is kept.
        const roleDefaults = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Roles.All.ToDictionary(r => r, Permissions.DefaultsFor)));
        let previousRoles = Array.from(roleSelect.selectedOptions).map(o => o.value);
        function applyRoleDefaults() {
            const selected = Array.from(roleSelect.selectedOptions).map(o => o.value);
            selected.filter(r => !previousRoles.includes(r)).forEach(r => {
                (roleDefaults[r] || []).forEach(key => {
                    const box = permissionGroup.querySelector(`input[name="PermissionKeys"][value="${key}"]`);
                    if (box) box.checked = true;
                });
            });
            previousRoles = selected;
        }
        roleSelect.addEventListener('change', applyRoleDefaults);
        if (typeof jQuery !== 'undefined') jQuery(roleSelect).on('select2:select select2:unselect', applyRoleDefaults);
    </script>
    <partial name="_ValidationScriptsPartial" />
}
