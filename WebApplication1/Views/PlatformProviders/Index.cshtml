@using WebApplication1.Models.Saas
@model List<PaymentProviderConfig>
@{
    ViewData["Title"] = "Payment providers";
    var configured = (Dictionary<string, bool>)ViewData["Configured"]!;
}

<div class="alert alert-info small">
    Credentials are never stored here. Set <code>Payments__SslCommerz__StoreId</code>, <code>Payments__SslCommerz__StorePassword</code>, <code>Payments__SslCommerz__Sandbox</code> and
    <code>Payments__PublicBaseUrl</code> as environment variables or user-secrets. A provider is offered to tenants only when it is enabled here <em>and</em> configured.
</div>

<div class="card mb-3"><div class="card-body p-0 table-responsive">
    <table class="table table-striped mb-0 align-middle">
        <thead><tr><th>Provider</th><th>Methods</th><th>Credentials</th><th>Switch</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            var isManual = p.Code == "manual";
            var ready = isManual || configured.GetValueOrDefault(p.Code);
            <tr>
                <td><div class="fw-semibold">@p.DisplayName</div><div class="small text-muted">@p.Code</div></td>
                <td class="small">@p.SupportedMethods</td>
                <td>@if (ready) { <span class="badge text-bg-success">@(isManual ? "n/a" : "Configured")</span> } else { <span class="badge text-bg-warning">Not configured</span> }</td>
                <td>@if (p.IsEnabled) { <span class="badge text-bg-success">Enabled</span> } else { <span class="badge text-bg-secondary">Disabled</span> }</td>
                <td class="text-end"><form asp-action="Toggle" asp-route-id="@p.Id" method="post"><button class="btn btn-sm @(p.IsEnabled ? "btn-outline-warning" : "btn-outline-success")">@(p.IsEnabled ? "Disable" : "Enable")</button></form></td>
            </tr>
        }
        </tbody>
    </table>
</div></div>

<div class="card" style="max-width: 820px;"><div class="card-body">
    <h6>Bank transfer / cash instructions shown to tenants</h6>
    <form asp-action="Instructions" method="post">
        <textarea name="instructions" rows="5" maxlength="1000" class="form-control mb-2">@ViewData["Instructions"]</textarea>
        <button class="btn btn-primary btn-sm">Save</button>
    </form>
</div></div>
