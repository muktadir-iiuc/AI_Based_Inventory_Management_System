@model PlatformCompanyViewModel
@{ ViewData["Title"] = "Company settings: " + Model.TenantName; }

@section Toolbar {
    <a href="/Platform/Tenants/@Model.TenantId" class="btn btn-outline-secondary btn-sm">Tenant</a>
    <a href="/Platform/Company" class="btn btn-outline-secondary btn-sm">All tenants</a>
}

<div class="card" style="max-width: 820px;">
    <form asp-action="Edit" asp-route-id="@Model.TenantId" method="post" enctype="multipart/form-data">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="TenantName" class="form-label required-asterisk"></label>
                <input asp-for="TenantName" class="form-control" />
                <span asp-validation-for="TenantName" class="text-danger small"></span>
                <div class="form-text">The business's name in the platform (tenant list, invoices' bill-to, billing emails). Tenant code: <strong>@Model.TenantCode</strong> (fixed).</div>
            </div>

            <hr />
            <h6>Company profile (as the business sees and prints it)</h6>
            <div class="mb-3">
                <label asp-for="CompanyName" class="form-label required-asterisk"></label>
                <input asp-for="CompanyName" class="form-control" />
                <span asp-validation-for="CompanyName" class="text-danger small"></span>
                <div class="form-text">Header of the business's invoice PDFs, page titles and footer, and its branded sign-in page.</div>
            </div>
            <div class="mb-3">
                <label asp-for="ShortName" class="form-label required-asterisk"></label>
                <input asp-for="ShortName" class="form-control" />
                <span asp-validation-for="ShortName" class="text-danger small"></span>
                <div class="form-text">Sidebar brand.</div>
            </div>
            <div class="mb-3"><label asp-for="Address" class="form-label"></label><textarea asp-for="Address" rows="2" class="form-control"></textarea><span asp-validation-for="Address" class="text-danger small"></span></div>
            <div class="mb-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" inputmode="tel" /><span asp-validation-for="Phone" class="text-danger small"></span></div>

            <div class="mb-3">
                <label asp-for="LogoFile" class="form-label"></label>
                @if (Model.HasLogo)
                {
                    <div class="mb-2"><img src="/CompanySettings/Logo?tenant=@Model.TenantCode&v=@DateTime.UtcNow.Ticks" alt="Current logo" class="border rounded bg-white p-1" style="max-height: 70px; max-width: 200px;" /></div>
                }
                <input asp-for="LogoFile" type="file" class="form-control" accept="image/png,image/jpeg,image/gif,image/bmp" />
                <span asp-validation-for="LogoFile" class="text-danger small"></span>
                <div class="form-text">PNG, JPEG, GIF or BMP up to 1 MB (checked by file content). Leave empty to keep the current logo.</div>
                @if (Model.HasLogo)
                {
                    <div class="form-check mt-2"><input asp-for="RemoveLogo" class="form-check-input" /><label asp-for="RemoveLogo" class="form-check-label"></label></div>
                }
            </div>
        </div>
        <div class="card-footer d-flex gap-2"><button class="btn btn-primary">Save</button><a href="/Platform/Company" class="btn btn-outline-secondary">Cancel</a></div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
