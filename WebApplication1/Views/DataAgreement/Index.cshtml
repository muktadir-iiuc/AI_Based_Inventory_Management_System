@using WebApplication1.Services.Saas
@{
    ViewData["Title"] = "Data agreement";
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_PlatformLoginLayout";
    var retention = (int)(ViewData["RetentionDays"] ?? 90);
}

<div class="@(User.Identity?.IsAuthenticated == true ? "card" : "platform-card p-4 p-sm-5") " style="max-width: 820px; margin: 0 auto;">
    <div class="@(User.Identity?.IsAuthenticated == true ? "card-body" : "")">
        <h3 class="mb-1">Data agreement</h3>
        <p class="text-secondary small">Version @DataAgreement.Version</p>
        @foreach (var (heading, body) in DataAgreement.Sections(retention))
        {
            <h5 class="mt-3">@heading</h5>
            <p class="mb-0">@body</p>
        }
    </div>
</div>
