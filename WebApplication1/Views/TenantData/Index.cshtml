@using WebApplication1.Models.Saas
@using WebApplication1.Services.Saas
@model WebApplication1.Controllers.TenantDataViewModel
@{ ViewData["Title"] = "Data & agreement"; }

@section Toolbar { <a href="/Billing" class="btn btn-outline-secondary btn-sm">Back to billing</a> }

<div class="row g-3">
    <div class="col-12 col-lg-5">
        <div class="card h-100">
            <div class="card-header"><h3 class="card-title mb-0">Data agreement</h3></div>
            <div class="card-body">
                @if (Model.AcceptedCurrent && Model.Latest is not null)
                {
                    <p class="mb-2"><span class="badge text-bg-success">Accepted</span> version @DataAgreement.Version</p>
                    <p class="small text-muted mb-2">Accepted by @Model.Latest.AcceptedBy on @Model.Latest.AcceptedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm") (@Model.Latest.Context).</p>
                    <a href="/DataAgreement" target="_blank" class="btn btn-outline-secondary btn-sm">Read the agreement</a>
                }
                else
                {
                    <p class="mb-2"><span class="badge text-bg-warning">Not accepted yet</span> version @DataAgreement.Version</p>
                    <p class="small">The agreement explains who owns your data, how it is protected, how to get a copy and what happens after your plan ends.</p>
                    <form asp-action="Accept" method="post">
                        <div class="form-check mb-3">
                            <input type="checkbox" class="form-check-input" id="agree" name="agree" value="true" />
                            <label class="form-check-label" for="agree">I have read and accept the <a href="/DataAgreement" target="_blank">data agreement</a>.</label>
                        </div>
                        <button class="btn btn-primary btn-sm">Accept</button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="card h-100">
            <div class="card-header"><h3 class="card-title mb-0">Get a copy of your data</h3></div>
            <div class="card-body">
                <p class="small text-muted">Ending your plan or moving to another system? Ask for every table that holds your business data. The platform team prepares it, and you download it here (available for 14 days). After a plan ends, data stays recoverable for @Model.RetentionDays days.</p>
                @if (Model.HasOpenRequest)
                {
                    <div class="alert alert-info py-2 mb-0">You already have a request waiting. We will prepare it as soon as possible.</div>
                }
                else
                {
                    <form asp-action="Request" method="post" class="row g-2">
                        <div class="col-6">
                            <label class="form-label small mb-0">Format</label>
                            <select name="format" class="form-select form-select-sm">
                                <option value="@ExportFormat.Csv">CSV (ZIP of files)</option>
                                <option value="@ExportFormat.Json">JSON (ZIP of files)</option>
                                <option value="@ExportFormat.Xlsx">Excel (XLSX workbook)</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-0">Why</label>
                            <select name="reason" class="form-select form-select-sm">
                                <option value="@ExportReason.CancelPlan">I am ending my plan</option>
                                <option value="@ExportReason.MoveToAnotherSystem">Moving to another system</option>
                                <option value="@ExportReason.Backup">Backup copy</option>
                                <option value="@ExportReason.Other">Other</option>
                            </select>
                        </div>
                        <div class="col-12"><label class="form-label small mb-0">Notes (optional)</label><input name="notes" maxlength="1000" class="form-control form-control-sm" /></div>
                        <div class="col-12"><button class="btn btn-primary btn-sm"><i class="fas fa-file-export"></i> Request my data</button></div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header"><h3 class="card-title mb-0">My data requests</h3></div>
    <div class="card-body p-0 table-responsive">
        <table class="table table-striped mb-0 align-middle">
            <thead><tr><th>Requested</th><th>Format</th><th>Reason</th><th>Status</th><th>Details</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in Model.Requests)
            {
                var badge = r.Status switch { ExportStatus.Ready => "success", ExportStatus.Requested => "warning", ExportStatus.Failed => "danger", _ => "secondary" };
                <tr>
                    <td>@r.RequestedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                    <td>@r.Format</td>
                    <td>@r.Reason</td>
                    <td><span class="badge text-bg-@badge">@(r.Status == ExportStatus.Failed ? "Being retried" : r.Status.ToString())</span></td>
                    <td class="small">@if (r.Status == ExportStatus.Ready) { <text>@r.TableCount tables, @r.RowCount.ToString("N0") rows. Available until @r.ExpiresAt?.ToLocalTime().ToString("dd MMM yyyy").</text> } else if (r.Status == ExportStatus.Rejected) { <text>@r.RejectReason</text> }</td>
                    <td class="text-end">@if (r.Status == ExportStatus.Ready) { <a asp-action="Download" asp-route-id="@r.Id" class="btn btn-primary btn-sm"><i class="fas fa-download"></i> Download</a> }</td>
                </tr>
            }
            @if (Model.Requests.Count == 0) { <tr><td colspan="6" class="text-center text-muted p-4">No requests yet.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
