@using WebApplication1.Models.Saas
@using WebApplication1.Models.Tenancy
@model TenantListViewModel
@{ ViewData["Title"] = "Tenants"; }

@section Toolbar {
    @if (User.IsInRole(Roles.PlatformAdmin))
    {
        <a href="/Platform/Tenants/Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> New tenant</a>
    }
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-4"><label class="form-label small mb-0">Search</label><input name="q" value="@Model.Q" class="form-control form-control-sm" placeholder="Name, code or email" /></div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-0">Tenant status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (var s in Enum.GetValues<TenantStatus>()) { <option value="@s" selected="@(Model.Status == s.ToString())">@s</option> }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-0">Subscription</label>
                <select name="sub" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (var s in Enum.GetValues<SubscriptionStatus>()) { <option value="@s" selected="@(Model.SubStatus == s.ToString())">@s</option> }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-0">Sort</label>
                <select name="sort" class="form-select form-select-sm">
                    <option value="created" selected="@(Model.Sort == "created")">Newest</option>
                    <option value="oldest" selected="@(Model.Sort == "oldest")">Oldest</option>
                    <option value="name" selected="@(Model.Sort == "name")">Name A-Z</option>
                    <option value="name_desc" selected="@(Model.Sort == "name_desc")">Name Z-A</option>
                    <option value="status" selected="@(Model.Sort == "status")">Status</option>
                </select>
            </div>
            <div class="col-6 col-md-2 d-flex gap-2"><button class="btn btn-primary btn-sm flex-grow-1">Filter</button><a href="/Platform/Tenants" class="btn btn-outline-secondary btn-sm">Reset</a></div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0 table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead><tr><th>Business</th><th>Status</th><th>Plan</th><th>Subscription</th><th>Renews / ends</th><th class="text-end">Users</th><th>Created</th></tr></thead>
            <tbody>
            @foreach (var row in Model.Page.Items)
            {
                var end = row.Subscription?.Status == SubscriptionStatus.Trialing ? row.Subscription.TrialEndsAt : row.Subscription?.CurrentPeriodEnd;
                <tr>
                    <td><a href="/Platform/Tenants/@row.Tenant.Id" class="fw-semibold">@row.Tenant.Name</a><div class="small text-muted">@row.Tenant.Code &middot; @row.Tenant.ContactEmail</div></td>
                    <td><partial name="_TenantBadge" model="row.Tenant" /></td>
                    <td>@row.PlanName</td>
                    <td>@if (row.Subscription is not null) { <partial name="_SubscriptionBadge" model="row.Subscription.Status" /> } else { <span class="text-muted">none</span> }</td>
                    <td>@(end?.ToLocalTime().ToString("dd MMM yyyy"))</td>
                    <td class="text-end">@row.Users</td>
                    <td>@row.Tenant.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                </tr>
            }
            @if (Model.Page.Items.Count == 0) { <tr><td colspan="7" class="text-center text-muted p-4">No tenants match.</td></tr> }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Page.Pager" />
</div>
