@model TenantProfileViewModel
@{ ViewData["Title"] = "Edit tenant"; }

<div class="card" style="max-width: 820px;">
    <form asp-action="Edit" method="post">
        <div class="card-body">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-12"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
                <div class="col-12 col-md-6"><label asp-for="ContactName" class="form-label"></label><input asp-for="ContactName" class="form-control" /></div>
                <div class="col-12 col-md-6"><label asp-for="ContactPhone" class="form-label"></label><input asp-for="ContactPhone" class="form-control" inputmode="tel" /></div>
                <div class="col-12 col-md-6"><label asp-for="ContactEmail" class="form-label"></label><input asp-for="ContactEmail" type="email" class="form-control" /></div>
                <div class="col-12 col-md-6"><label asp-for="BillingEmail" class="form-label"></label><input asp-for="BillingEmail" type="email" class="form-control" /></div>
                <div class="col-12"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /></div>
                <div class="col-12 col-md-4"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /></div>
                <div class="col-12 col-md-4"><label asp-for="Country" class="form-label"></label><input asp-for="Country" class="form-control" /></div>
                <div class="col-12 col-md-4"><label asp-for="TaxId" class="form-label"></label><input asp-for="TaxId" class="form-control" /></div>
            </div>
        </div>
        <div class="card-footer d-flex gap-2"><button class="btn btn-primary">Save</button><a href="@Url.Action("Details", new { id = Context.Request.RouteValues["id"] })" class="btn btn-outline-secondary">Cancel</a></div>
    </form>
</div>
