@model PasswordResetViewModel
@{ ViewData["Title"] = "Temporary password"; }

<div class="card border-warning" style="max-width: 720px;">
    <div class="card-body">
        <h4><i class="fas fa-key me-2"></i>Password reset for @Model.Email</h4>
        <p class="text-muted mb-3">Tenant: <a href="/Platform/Tenants/@Model.TenantId">@Model.TenantName</a></p>

        <div class="alert alert-warning small">
            This is the only time the password is shown. It is not stored or logged. Give it to the user through a private channel.
            They are signed out everywhere and must choose their own password the next time they sign in.
        </div>

        <label class="form-label">Temporary password</label>
        <div class="input-group mb-3">
            <input id="tmpPw" class="form-control font-monospace fs-5" readonly value="@Model.Password" />
            <button type="button" class="btn btn-outline-secondary" id="copyPw"><i class="fas fa-copy"></i> Copy</button>
        </div>

        <label class="form-label">Sign-in address</label>
        <div class="input-group mb-4">
            <input id="tmpUrl" class="form-control" readonly value="@Model.SignInUrl" />
            <button type="button" class="btn btn-outline-secondary" data-copy="#tmpUrl"><i class="fas fa-copy"></i> Copy</button>
        </div>

        <a href="/Platform/Tenants/@Model.TenantId" class="btn btn-primary">Done</a>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('#copyPw, [data-copy]').forEach(function (b) {
            b.addEventListener('click', function () {
                var el = document.querySelector(b.getAttribute('data-copy') || '#tmpPw');
                el.select();
                navigator.clipboard ? navigator.clipboard.writeText(el.value) : document.execCommand('copy');
                b.textContent = 'Copied';
            });
        });
    </script>
}
